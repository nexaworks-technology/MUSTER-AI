{
  "name": "nexaworks-csm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 . && tsx scripts/check-secrets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "services:native": "sh scripts/services-native.sh",
    "dev:worker": "tsx watch --env-file=.env src/worker/index.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "jobs:nightly": "tsx --env-file=.env scripts/jobs-nightly.ts",
    "outcomes:backfill": "tsx --env-file=.env scripts/outcomes-backfill.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "agents:extract": "tsx --env-file=.env scripts/agents-extract.ts",
    "demo:webhook": "tsx --env-file=.env scripts/demo-webhook.ts",
    "demo:usage": "tsx --env-file=.env scripts/demo-usage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "bullmq": "6.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "file-type": "22.1.1",
    "gray-matter": "4.0.3",
    "ioredis": "5.11.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
