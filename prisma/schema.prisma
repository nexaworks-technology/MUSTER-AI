// Data model. Conventions: prisma/README.md and docs/ARCHITECTURE.md §3.
// Runtime connects as app_user (DATABASE_URL, subject to RLS); migrations run as the
// schema owner (DATABASE_URL_MIGRATE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  CS_LEADER
  CSM
  VIEWER
}

enum BookScope {
  OWN
  TEAM
  ALL
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum AuditActorType {
  USER
  AGENT
  SYSTEM
  INTEGRATION
  PORTAL_CONTACT
}

// ─── Root (tenant) ───────────────────────────────────────────────────────────

/// The tenant boundary: one of our customers. Root table — not workspace-scoped itself.
model Workspace {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  timezone            String          @default("UTC")
  baseCurrency        String          @default("USD") @db.Char(3)
  status              WorkspaceStatus @default(ACTIVE)
  dataRetentionDays   Int?
  deletionRequestedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  settings     WorkspaceSettings?
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]
  sessions     Session[]

  accounts         Account[]
  contacts         Contact[]
  stakeholderRoles StakeholderRole[]
  contracts        Contract[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  revenueEvents    RevenueEvent[]
}

// ─── Global identity (Auth.js) ───────────────────────────────────────────────

/// [G] A person who can sign in. Email is stored lower-cased.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// argon2id hash for credentials sign-in; null for Google-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authAccounts AuthAccount[]
  sessions     Session[]
  memberships  Membership[]
}

/// [G] Auth.js linked OAuth account. Named AuthAccount so `Account` stays the customer
/// account (DECISIONS D-08). Token columns hold ciphertext from src/lib/crypto.
model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// [G] Database session (DECISIONS D-07). activeWorkspaceId drives workspace context.
model Session {
  id                String   @id @default(cuid())
  sessionToken      String   @unique
  userId            String
  expires           DateTime
  activeWorkspaceId String?
  createdAt         DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// [G] Auth.js verification tokens (email sign-in flows).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspace-scoped [W] ────────────────────────────────────────────────────

/// [W] A user's role in one workspace (ARCHITECTURE §7.2).
model Membership {
  id             String           @id @default(cuid())
  workspaceId    String
  userId         String
  role           Role
  canViewRevenue Boolean          @default(false)
  bookScope      BookScope        @default(OWN)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationsCreated Invitation[] @relation("InvitedBy")
  ownedAccounts      Account[]    @relation("AccountOwner")

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId])
}

/// [W] A pending invitation. Only the SHA-256 of the token is stored.
model Invitation {
  id                    String    @id @default(cuid())
  workspaceId           String
  email                 String
  role                  Role
  canViewRevenue        Boolean   @default(false)
  bookScope             BookScope @default(OWN)
  tokenHash             String    @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedUserId        String?
  revokedAt             DateTime?
  invitedByMembershipId String
  createdAt             DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Composite FK: the inviter must be a member of the same workspace (ARCHITECTURE §3.1).
  invitedBy Membership @relation("InvitedBy", fields: [workspaceId, invitedByMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, email])
}

/// [W] Zod-typed workspace settings (src/modules/settings/schemas.ts).
model WorkspaceSettings {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  data        Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
}

/// [W] Append-only audit trail (Rule 5, spec §6N2). UPDATE/DELETE are blocked by a trigger.
model AuditLog {
  id          String         @id @default(cuid())
  workspaceId String
  actorType   AuditActorType
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  /// AgentRun id once agents exist (M4); plain column until then.
  agentRunId  String?
  summary     String
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
}

// ─── Global infrastructure ───────────────────────────────────────────────────

/// [G*] Transactional outbox (D-22). Read only by the worker dispatcher, which re-scopes
/// every handler with the event's workspaceId.
model OutboxEvent {
  id          String    @id @default(cuid())
  workspaceId String
  type        String
  payload     Json
  availableAt DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([processedAt, availableAt])
}

// ─── M2: Accounts & people ───────────────────────────────────────────────────

enum AccountTier {
  HIGH_TOUCH
  MID_TOUCH
  LONG_TAIL
}

enum TierSource {
  RULE
  MANUAL
}

enum LifecycleStage {
  ONBOARDING
  ADOPTING
  MATURE
  RENEWING
  LOST
}

/// Where a record came from (ARCHITECTURE §3.1). Connector values are added with their milestone.
enum RecordSource {
  CSV
  MANUAL
  SEED
  SYSTEM
}

/// Who wrote a record. origin = AI requires agentRunId (Rule 5, DB CHECK).
enum RecordOrigin {
  HUMAN
  SYSTEM
  AI
  IMPORT
}

enum ContactStatus {
  ACTIVE
  BOUNCED
  LEFT
  UNKNOWN
}

enum StakeholderRoleType {
  CHAMPION
  DECISION_MAKER
  DAILY_USER
  EXEC_SPONSOR
  BILLING
  OTHER
}

/// [W] One of our customer's customers — the centre of the Account Graph (spec §6A1).
model Account {
  id                  String         @id @default(cuid())
  workspaceId         String
  name                String
  domain              String?
  tier                AccountTier
  tierSource          TierSource     @default(RULE)
  lifecycleStage      LifecycleStage @default(ADOPTING)
  stageChangedAt      DateTime?
  onboardingStartedAt DateTime?
  churnedAt           DateTime?
  ownerMembershipId   String?
  plan                String?
  industry            String?
  employeeBand        String?
  useCase             String?
  timezone            String?
  /// Derived from the active contract (billing service). Null = no contract on file, never 0.
  arrMinor            BigInt?
  arrCurrency         String?        @db.Char(3)
  /// Derived from the current contract; null = no renewal date on file.
  renewalDate         DateTime?
  lastTouchAt         DateTime?
  source              RecordSource   @default(MANUAL)
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            Membership?       @relation("AccountOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)
  contacts         Contact[]
  stakeholderRoles StakeholderRole[]
  contracts        Contract[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  revenueEvents    RevenueEvent[]

  @@unique([workspaceId, id])
  @@index([workspaceId, renewalDate])
  @@index([workspaceId, ownerMembershipId])
  @@index([workspaceId, tier])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, name])
  @@index([workspaceId, domain])
  @@index([workspaceId, arrMinor])
  @@index([workspaceId, lastTouchAt])
}

/// [W] A person at an account (spec §6A2).
model Contact {
  id             String        @id @default(cuid())
  workspaceId    String
  accountId      String
  name           String
  email          String?
  title          String?
  timezone       String?
  status         ContactStatus @default(ACTIVE)
  /// The customer's own id for this person in product usage data (links UserUsageDaily rows).
  externalUserId String?
  lastContactAt  DateTime?
  source         RecordSource  @default(MANUAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account           @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  roles     StakeholderRole[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
  @@index([workspaceId, email])
}

/// [W] A contact's role over time (champion, decision maker…). History is kept for back-tests.
model StakeholderRole {
  id                String              @id @default(cuid())
  workspaceId       String
  accountId         String
  contactId         String
  role              StakeholderRoleType
  validFrom         DateTime
  validTo           DateTime?
  setByMembershipId String?
  origin            RecordOrigin        @default(HUMAN)
  /// AgentRun id; FK added in M4 (CHECK origin <> AI OR agentRunId IS NOT NULL).
  agentRunId        String?
  createdAt         DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, role, validTo])
  @@index([workspaceId, contactId])
}

// ─── M2: Commercial ──────────────────────────────────────────────────────────

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  ENDED
}

enum InvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
  UNCOLLECTIBLE
}

enum RevenueEventType {
  NEW
  EXPANSION
  CONTRACTION
  CHURN
  REACTIVATION
}

enum ComputedBy {
  RULE
}

/// [W] Contract & commercial record (spec §6A3). Terms and pricing notes are encrypted (INTERP-4).
model Contract {
  id               String         @id @default(cuid())
  workspaceId      String
  accountId        String
  startDate        DateTime
  endDate          DateTime?
  /// Null = no renewal date on file (the missing-data helper asks for it).
  renewalDate      DateTime?
  autoRenew        Boolean?
  noticePeriodDays Int?
  /// Annual value in minor units. Null = value not on file (never treated as 0).
  valueMinor       BigInt?
  currency         String         @default("USD") @db.Char(3)
  seatsPurchased   Int?
  creditsPurchased Int?
  termsEnc         String?
  pricingNotesEnc  String?
  status           ContractStatus @default(ACTIVE)
  /// FileObject id of the signed contract; FK added with FileObject (M2 slice 11).
  documentFileId   String?
  source           RecordSource   @default(MANUAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, startDate])
  @@index([workspaceId, renewalDate])
}

/// [W] A billing subscription (Stripe/Chargebee in M5; CSV/seed now).
model Subscription {
  id               String             @id @default(cuid())
  workspaceId      String
  accountId        String
  contractId       String?
  plan             String
  interval         BillingInterval
  amountMinor      BigInt
  currency         String             @default("USD") @db.Char(3)
  quantity         Int                @default(1)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  source           RecordSource       @default(MANUAL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contract  Contract? @relation(fields: [workspaceId, contractId], references: [workspaceId, id], onDelete: SetNull)
  invoices  Invoice[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

/// [W] An invoice and its payment outcome.
model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  accountId      String
  subscriptionId String?
  number         String
  amountMinor    BigInt
  currency       String        @default("USD") @db.Char(3)
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  status         InvoiceStatus @default(OPEN)
  failureCount   Int           @default(0)
  lastFailedAt   DateTime?
  source         RecordSource  @default(MANUAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [workspaceId, subscriptionId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, accountId, issuedAt])
}

/// [W] ARR movement derived by rule from contracts (never typed in, never from an LLM).
model RevenueEvent {
  id            String           @id @default(cuid())
  workspaceId   String
  accountId     String
  type          RevenueEventType
  deltaArrMinor BigInt
  currency      String           @db.Char(3)
  effectiveDate DateTime
  sourceType    String
  sourceId      String
  computedBy    ComputedBy       @default(RULE)
  createdAt     DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceType, sourceId, type])
  @@index([workspaceId, effectiveDate])
  @@index([workspaceId, accountId])
}
