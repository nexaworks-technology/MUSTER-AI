// Data model. Conventions: prisma/README.md and docs/ARCHITECTURE.md §3.
// Runtime connects as app_user (DATABASE_URL, subject to RLS); migrations run as the
// schema owner (DATABASE_URL_MIGRATE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  CS_LEADER
  CSM
  VIEWER
}

enum BookScope {
  OWN
  TEAM
  ALL
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum AuditActorType {
  USER
  AGENT
  SYSTEM
  INTEGRATION
  PORTAL_CONTACT
}

// ─── Root (tenant) ───────────────────────────────────────────────────────────

/// The tenant boundary: one of our customers. Root table — not workspace-scoped itself.
model Workspace {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  timezone            String          @default("UTC")
  baseCurrency        String          @default("USD") @db.Char(3)
  status              WorkspaceStatus @default(ACTIVE)
  dataRetentionDays   Int?
  deletionRequestedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  settings     WorkspaceSettings?
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]
  sessions     Session[]

  accounts         Account[]
  contacts         Contact[]
  stakeholderRoles StakeholderRole[]
  contracts        Contract[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  revenueEvents    RevenueEvent[]
  usageDaily       UsageDaily[]
  userUsageDaily   UserUsageDaily[]
  featureUsage     FeatureUsageDaily[]
  featureCatalog   FeatureCatalog[]
  conversations    Conversation[]
  messages         Message[]
  tickets          Ticket[]
  transcripts      CallTranscript[]
  tasks            Task[]
  noteTemplates    NoteTemplate[]
  notes            Note[]
  notifications    Notification[]
  segments         Segment[]
  files            FileObject[]
  externalRefs     ExternalRef[]
  importJobs       ImportJob[]
  missingPrompts   MissingDataPrompt[]
  dataIssues       DataQualityIssue[]
}

// ─── Global identity (Auth.js) ───────────────────────────────────────────────

/// [G] A person who can sign in. Email is stored lower-cased.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// argon2id hash for credentials sign-in; null for Google-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authAccounts AuthAccount[]
  sessions     Session[]
  memberships  Membership[]
}

/// [G] Auth.js linked OAuth account. Named AuthAccount so `Account` stays the customer
/// account (DECISIONS D-08). Token columns hold ciphertext from src/lib/crypto.
model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// [G] Database session (DECISIONS D-07). activeWorkspaceId drives workspace context.
model Session {
  id                String   @id @default(cuid())
  sessionToken      String   @unique
  userId            String
  expires           DateTime
  activeWorkspaceId String?
  createdAt         DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// [G] Auth.js verification tokens (email sign-in flows).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspace-scoped [W] ────────────────────────────────────────────────────

/// [W] A user's role in one workspace (ARCHITECTURE §7.2).
model Membership {
  id             String           @id @default(cuid())
  workspaceId    String
  userId         String
  role           Role
  canViewRevenue Boolean          @default(false)
  bookScope      BookScope        @default(OWN)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationsCreated Invitation[]        @relation("InvitedBy")
  ownedAccounts      Account[]           @relation("AccountOwner")
  sentMessages       Message[]           @relation("MessageFromMember")
  ownedTasks         Task[]              @relation("TaskOwner")
  createdTasks       Task[]              @relation("TaskCreator")
  notes              Note[]              @relation("NoteAuthor")
  notifications      Notification[]      @relation("NotificationRecipient")
  segments           Segment[]           @relation("SegmentCreator")
  uploadedFiles      FileObject[]        @relation("FileUploader")
  importJobs         ImportJob[]         @relation("ImportCreator")
  missingPrompts     MissingDataPrompt[] @relation("PromptAskedTo")

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId])
}

/// [W] A pending invitation. Only the SHA-256 of the token is stored.
model Invitation {
  id                    String    @id @default(cuid())
  workspaceId           String
  email                 String
  role                  Role
  canViewRevenue        Boolean   @default(false)
  bookScope             BookScope @default(OWN)
  tokenHash             String    @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedUserId        String?
  revokedAt             DateTime?
  invitedByMembershipId String
  createdAt             DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Composite FK: the inviter must be a member of the same workspace (ARCHITECTURE §3.1).
  invitedBy Membership @relation("InvitedBy", fields: [workspaceId, invitedByMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, email])
}

/// [W] Zod-typed workspace settings (src/modules/settings/schemas.ts).
model WorkspaceSettings {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  data        Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
}

/// [W] Append-only audit trail (Rule 5, spec §6N2). UPDATE/DELETE are blocked by a trigger.
model AuditLog {
  id          String         @id @default(cuid())
  workspaceId String
  actorType   AuditActorType
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  /// AgentRun id once agents exist (M4); plain column until then.
  agentRunId  String?
  summary     String
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
}

// ─── Global infrastructure ───────────────────────────────────────────────────

/// [G*] Transactional outbox (D-22). Read only by the worker dispatcher, which re-scopes
/// every handler with the event's workspaceId.
model OutboxEvent {
  id          String    @id @default(cuid())
  workspaceId String
  type        String
  payload     Json
  availableAt DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([processedAt, availableAt])
}

// ─── M2: Accounts & people ───────────────────────────────────────────────────

enum AccountTier {
  HIGH_TOUCH
  MID_TOUCH
  LONG_TAIL
}

enum TierSource {
  RULE
  MANUAL
}

enum LifecycleStage {
  ONBOARDING
  ADOPTING
  MATURE
  RENEWING
  LOST
}

/// Where a record came from (ARCHITECTURE §3.1). Connector values are added with their milestone.
enum RecordSource {
  CSV
  MANUAL
  SEED
  SYSTEM
}

/// Who wrote a record. origin = AI requires agentRunId (Rule 5, DB CHECK).
enum RecordOrigin {
  HUMAN
  SYSTEM
  AI
  IMPORT
}

enum ContactStatus {
  ACTIVE
  BOUNCED
  LEFT
  UNKNOWN
}

enum StakeholderRoleType {
  CHAMPION
  DECISION_MAKER
  DAILY_USER
  EXEC_SPONSOR
  BILLING
  OTHER
}

/// [W] One of our customer's customers — the centre of the Account Graph (spec §6A1).
model Account {
  id                  String         @id @default(cuid())
  workspaceId         String
  name                String
  domain              String?
  tier                AccountTier
  tierSource          TierSource     @default(RULE)
  lifecycleStage      LifecycleStage @default(ADOPTING)
  stageChangedAt      DateTime?
  onboardingStartedAt DateTime?
  churnedAt           DateTime?
  ownerMembershipId   String?
  plan                String?
  industry            String?
  employeeBand        String?
  useCase             String?
  timezone            String?
  /// Derived from the active contract (billing service). Null = no contract on file, never 0.
  arrMinor            BigInt?
  arrCurrency         String?        @db.Char(3)
  /// Derived from the current contract; null = no renewal date on file.
  renewalDate         DateTime?
  lastTouchAt         DateTime?
  source              RecordSource   @default(MANUAL)
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            Membership?         @relation("AccountOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)
  contacts         Contact[]
  stakeholderRoles StakeholderRole[]
  contracts        Contract[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  revenueEvents    RevenueEvent[]
  usageDaily       UsageDaily[]
  userUsageDaily   UserUsageDaily[]
  featureUsage     FeatureUsageDaily[]
  conversations    Conversation[]
  messages         Message[]
  tickets          Ticket[]
  transcripts      CallTranscript[]
  tasks            Task[]
  notes            Note[]
  files            FileObject[]
  missingPrompts   MissingDataPrompt[]
  dataIssues       DataQualityIssue[]

  @@unique([workspaceId, id])
  @@index([workspaceId, renewalDate])
  @@index([workspaceId, ownerMembershipId])
  @@index([workspaceId, tier])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, name])
  @@index([workspaceId, domain])
  @@index([workspaceId, arrMinor])
  @@index([workspaceId, lastTouchAt])
}

/// [W] A person at an account (spec §6A2).
model Contact {
  id              String        @id @default(cuid())
  workspaceId     String
  accountId       String
  name            String
  email           String?
  title           String?
  timezone        String?
  status          ContactStatus @default(ACTIVE)
  /// When `status` last changed (D-56). Set by the database on a real change unless given.
  statusChangedAt DateTime?
  /// The customer's own id for this person in product usage data (links UserUsageDaily rows).
  externalUserId  String?
  lastContactAt   DateTime?
  source          RecordSource  @default(MANUAL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account           @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  roles     StakeholderRole[]
  usage     UserUsageDaily[]
  messages  Message[]
  tickets   Ticket[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
  @@index([workspaceId, email])
}

/// [W] A contact's role over time (champion, decision maker…). History is kept for back-tests.
model StakeholderRole {
  id                String              @id @default(cuid())
  workspaceId       String
  accountId         String
  contactId         String
  role              StakeholderRoleType
  validFrom         DateTime
  validTo           DateTime?
  setByMembershipId String?
  origin            RecordOrigin        @default(HUMAN)
  /// AgentRun id; FK added in M4 (CHECK origin <> AI OR agentRunId IS NOT NULL).
  agentRunId        String?
  createdAt         DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, role, validTo])
  @@index([workspaceId, contactId])
}

// ─── M2: Commercial ──────────────────────────────────────────────────────────

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  ENDED
}

enum InvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
  UNCOLLECTIBLE
}

enum RevenueEventType {
  NEW
  EXPANSION
  CONTRACTION
  CHURN
  REACTIVATION
}

enum ComputedBy {
  RULE
}

/// [W] Contract & commercial record (spec §6A3). Terms and pricing notes are encrypted (INTERP-4).
model Contract {
  id               String         @id @default(cuid())
  workspaceId      String
  accountId        String
  startDate        DateTime
  endDate          DateTime?
  /// Null = no renewal date on file (the missing-data helper asks for it).
  renewalDate      DateTime?
  autoRenew        Boolean?
  noticePeriodDays Int?
  /// Annual value in minor units. Null = value not on file (never treated as 0).
  valueMinor       BigInt?
  currency         String         @default("USD") @db.Char(3)
  seatsPurchased   Int?
  creditsPurchased Int?
  termsEnc         String?
  pricingNotesEnc  String?
  status           ContractStatus @default(ACTIVE)
  /// The signed contract document (composite FK to FileObject).
  documentFileId   String?
  source           RecordSource   @default(MANUAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  subscriptions Subscription[]
  document      FileObject?    @relation(fields: [workspaceId, documentFileId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, startDate])
  @@index([workspaceId, renewalDate])
}

/// [W] A billing subscription (Stripe/Chargebee in M5; CSV/seed now).
model Subscription {
  id               String             @id @default(cuid())
  workspaceId      String
  accountId        String
  contractId       String?
  plan             String
  interval         BillingInterval
  amountMinor      BigInt
  currency         String             @default("USD") @db.Char(3)
  quantity         Int                @default(1)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  source           RecordSource       @default(MANUAL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contract  Contract? @relation(fields: [workspaceId, contractId], references: [workspaceId, id], onDelete: SetNull)
  invoices  Invoice[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

/// [W] An invoice and its payment outcome.
model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  accountId      String
  subscriptionId String?
  number         String
  amountMinor    BigInt
  currency       String        @default("USD") @db.Char(3)
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  status         InvoiceStatus @default(OPEN)
  failureCount   Int           @default(0)
  lastFailedAt   DateTime?
  source         RecordSource  @default(MANUAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [workspaceId, subscriptionId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, accountId, issuedAt])
}

/// [W] ARR movement derived by rule from contracts (never typed in, never from an LLM).
model RevenueEvent {
  id            String           @id @default(cuid())
  workspaceId   String
  accountId     String
  type          RevenueEventType
  deltaArrMinor BigInt
  currency      String           @db.Char(3)
  effectiveDate DateTime
  sourceType    String
  sourceId      String
  computedBy    ComputedBy       @default(RULE)
  createdAt     DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceType, sourceId, type])
  @@index([workspaceId, effectiveDate])
  @@index([workspaceId, accountId])
}

// ─── M2: Usage (daily aggregates only, D-23) ─────────────────────────────────

/// [W] Account-level product usage per day.
model UsageDaily {
  id          String       @id @default(cuid())
  workspaceId String
  accountId   String
  date        DateTime     @db.Date
  activeUsers Int
  sessions    Int
  events      Int
  seatsUsed   Int?
  creditsUsed Int?
  source      RecordSource @default(MANUAL)
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, date])
}

/// [W] Per-user product usage per day. contactId links to a known person when we have one.
model UserUsageDaily {
  id             String       @id @default(cuid())
  workspaceId    String
  accountId      String
  contactId      String?
  externalUserId String
  date           DateTime     @db.Date
  events         Int
  sessions       Int
  source         RecordSource @default(MANUAL)
  createdAt      DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, externalUserId, date])
  @@index([workspaceId, accountId, date])
}

/// [W] Per-feature product usage per day.
model FeatureUsageDaily {
  id          String       @id @default(cuid())
  workspaceId String
  accountId   String
  featureKey  String
  date        DateTime     @db.Date
  users       Int
  events      Int
  source      RecordSource @default(MANUAL)
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, featureKey, date])
}

/// [W] The customer's product features, which are key, and which plans include them.
model FeatureCatalog {
  id              String   @id @default(cuid())
  workspaceId     String
  featureKey      String
  label           String
  isKeyFeature    Boolean  @default(false)
  includedInPlans String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, featureKey])
}

// ─── M2: Support & conversations ─────────────────────────────────────────────

enum TicketStatus {
  OPEN
  PENDING
  SOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationChannel {
  EMAIL
  CALL
  CHAT
  TICKET
  MEETING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SentimentLabel {
  NEGATIVE
  NEUTRAL
  POSITIVE
  MIXED
}

/// [W] A thread of messages with an account (email thread, call, chat, ticket thread).
model Conversation {
  id               String              @id @default(cuid())
  workspaceId      String
  accountId        String
  channel          ConversationChannel
  subject          String?
  startedAt        DateTime
  lastMessageAt    DateTime
  externalThreadId String?
  source           RecordSource        @default(MANUAL)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  messages    Message[]
  tickets     Ticket[]
  transcripts CallTranscript[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, lastMessageAt])
}

/// [W] One message. The text is a source record that extraction (M4/M9) will read.
model Message {
  id                  String           @id @default(cuid())
  workspaceId         String
  conversationId      String
  accountId           String
  direction           MessageDirection
  fromContactId       String?
  fromMembershipId    String?
  fromAddress         String?
  toAddresses         String[]
  sentAt              DateTime
  subject             String?
  bodyText            String
  bodyStorageKey      String?
  /// Written only by an AI run (M4/M9): a label without its AgentRun is rejected (DB CHECK).
  sentimentLabel      SentimentLabel?
  sentimentAgentRunId String?
  source              RecordSource     @default(MANUAL)
  createdAt           DateTime         @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  account      Account      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  fromContact  Contact?     @relation(fields: [workspaceId, fromContactId], references: [workspaceId, id], onDelete: SetNull)
  fromMember   Membership?  @relation("MessageFromMember", fields: [workspaceId, fromMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, sentAt])
  @@index([workspaceId, conversationId, sentAt])
}

/// [W] A support ticket (Zendesk/Freshdesk in M9; CSV/seed now). Its thread is a Conversation.
model Ticket {
  id              String         @id @default(cuid())
  workspaceId     String
  accountId       String
  contactId       String?
  conversationId  String?
  externalId      String?
  subject         String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  isEscalated     Boolean        @default(false)
  /// When the ticket was escalated (D-56). Set by the database on escalation unless given.
  escalatedAt     DateTime?
  openedAt        DateTime
  firstResponseAt DateTime?
  closedAt        DateTime?
  source          RecordSource   @default(MANUAL)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, status])
  @@index([workspaceId, openedAt])
}

/// [W] A call transcript (Fireflies/Gong/Zoom in M10; seed/upload now). Read-only in M2.
model CallTranscript {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  accountId      String
  title          String
  provider       String
  language       String       @default("en")
  occurredAt     DateTime
  text           String
  segments       Json?
  durationSec    Int?
  source         RecordSource @default(MANUAL)
  createdAt      DateTime     @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  account      Account      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, occurredAt])
}

// ─── M2: Work — tasks, notes, notifications ──────────────────────────────────

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum NotificationType {
  MENTION
  TASK_ASSIGNED
}

/// [W] A unit of work for one member (spec §6F3). Agents and plays create tasks from M4/M8.
model Task {
  id                    String       @id @default(cuid())
  workspaceId           String
  accountId             String?
  title                 String
  detail                String?
  ownerMembershipId     String
  createdByMembershipId String?
  dueAt                 DateTime?
  status                TaskStatus   @default(OPEN)
  priority              TaskPriority @default(NORMAL)
  completedAt           DateTime?
  escalatedAt           DateTime?
  origin                RecordOrigin @default(HUMAN)
  agentRunId            String?
  source                RecordSource @default(MANUAL)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account?    @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  owner     Membership  @relation("TaskOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)
  createdBy Membership? @relation("TaskCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, ownerMembershipId, status, dueAt])
  @@index([workspaceId, accountId])
}

/// [W] A note template per call type (spec §6F4).
model NoteTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  callType    String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

/// [W] A note on an account, with tags and @mentions (spec §6F4).
model Note {
  id                   String       @id @default(cuid())
  workspaceId          String
  accountId            String
  authorMembershipId   String?
  templateId           String?
  body                 String
  tags                 String[]
  mentionMembershipIds String[]
  origin               RecordOrigin @default(HUMAN)
  agentRunId           String?
  source               RecordSource @default(MANUAL)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  author    Membership?   @relation("NoteAuthor", fields: [workspaceId, authorMembershipId], references: [workspaceId, id], onDelete: SetNull)
  template  NoteTemplate? @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, createdAt])
}

/// [W] An in-app notification for one member.
model Notification {
  id                    String           @id @default(cuid())
  workspaceId           String
  recipientMembershipId String
  type                  NotificationType
  title                 String
  refType               String
  refId                 String
  accountId             String?
  readAt                DateTime?
  createdAt             DateTime         @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Membership @relation("NotificationRecipient", fields: [workspaceId, recipientMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, recipientMembershipId, readAt])
}

/// [W] A saved account filter (spec §6F5). `filter` is the Zod-validated segment DSL (D-45).
model Segment {
  id                    String   @id @default(cuid())
  workspaceId           String
  name                  String
  filter                Json
  isDynamic             Boolean  @default(true)
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("SegmentCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

// ─── M2: Files ───────────────────────────────────────────────────────────────

enum FilePurpose {
  CONTRACT_DOCUMENT
  CSV_IMPORT
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
}

/// [W] An uploaded file. The storage key is generated by us under ws/<workspaceId>/ and is never
/// exposed; files are served only by /api/files/[id]/download after access checks (§7.6).
model FileObject {
  id                     String      @id @default(cuid())
  workspaceId            String
  accountId              String?
  purpose                FilePurpose
  storageKey             String      @unique
  filename               String
  mimeType               String
  sizeBytes              Int
  sha256                 String
  scanStatus             ScanStatus  @default(PENDING)
  uploadedByMembershipId String?
  createdAt              DateTime    @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  uploadedBy Membership? @relation("FileUploader", fields: [workspaceId, uploadedByMembershipId], references: [workspaceId, id], onDelete: SetNull)
  contracts  Contract[]
  importJobs ImportJob[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

// ─── M2: Import plumbing ─────────────────────────────────────────────────────

enum ImportKind {
  ACCOUNTS
  CONTACTS
  CONTRACTS
  INVOICES
  USAGE_ACCOUNT_DAILY
  USAGE_USER_DAILY
  USAGE_FEATURE_DAILY
  TICKETS
  TICKET_MESSAGES
}

enum ImportStatus {
  UPLOADED
  PREVIEWED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// [W] Maps an outside id to our record, so re-imports update instead of duplicating
/// (ARCHITECTURE §8.1). Unique per workspace + source + record type + external id.
model ExternalRef {
  id            String       @id @default(cuid())
  workspaceId   String
  source        RecordSource
  objectType    String
  externalId    String
  internalType  String
  internalId    String
  /// Integration id once connectors exist (M5); null for CSV.
  integrationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, source, objectType, externalId])
  @@index([workspaceId, internalType, internalId])
}

/// [W] One CSV import: upload → mapping → preview (dry run) → confirm → background run → report.
model ImportJob {
  id                    String       @id @default(cuid())
  workspaceId           String
  kind                  ImportKind
  fileObjectId          String
  status                ImportStatus @default(UPLOADED)
  headers               String[]
  /// Our field key → the CSV column it reads from.
  mapping               Json
  rowsTotal             Int          @default(0)
  rowsValid             Int          @default(0)
  created               Int          @default(0)
  updated               Int          @default(0)
  unchanged             Int          @default(0)
  failed                Int          @default(0)
  /// Per-row problems in plain words (capped), plus the full count.
  report                Json?
  errorPlain            String?
  createdByMembershipId String?
  confirmedAt           DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      FileObject  @relation(fields: [workspaceId, fileObjectId], references: [workspaceId, id], onDelete: Restrict)
  createdBy Membership? @relation("ImportCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

enum MissingDataField {
  OWNER
  RENEWAL_DATE
  KEY_CONTACT
}

/// [W] The missing-data helper's memory per account + field: when it was last shown, to whom,
/// and whether it was answered or snoozed (spec §6A5).
model MissingDataPrompt {
  id                     String           @id @default(cuid())
  workspaceId            String
  accountId              String
  field                  MissingDataField
  askedMembershipId      String?
  askedAt                DateTime?
  answeredAt             DateTime?
  answeredByMembershipId String?
  skippedAt              DateTime?
  snoozeUntil            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account     @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  askedTo   Membership? @relation("PromptAskedTo", fields: [workspaceId, askedMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, field])
  @@index([workspaceId, askedMembershipId, askedAt])
}

enum DataQualityKind {
  DUPLICATE_ACCOUNT
  DUPLICATE_CONTACT
  INVALID_EMAIL
  STALE
}

enum DataQualityStatus {
  OPEN
  FIXED
  DISMISSED
  RESOLVED
}

/// [W] A data problem for a person to review (spec §6A6). The suggested fix is applied only
/// after confirmation; RESOLVED means a later scan no longer found it.
model DataQualityIssue {
  id                  String            @id @default(cuid())
  workspaceId         String
  accountId           String?
  contactId           String?
  kind                DataQualityKind
  detail              String
  suggestedFix        Json
  dedupeKey           String
  status              DataQualityStatus @default(OPEN)
  fixedByMembershipId String?
  fixedAt             DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status])
}
