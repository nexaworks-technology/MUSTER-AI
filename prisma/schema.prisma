// Data model. Conventions: prisma/README.md and docs/ARCHITECTURE.md §3.
// Runtime connects as app_user (DATABASE_URL, subject to RLS); migrations run as the
// schema owner (DATABASE_URL_MIGRATE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  CS_LEADER
  CSM
  VIEWER
}

enum BookScope {
  OWN
  TEAM
  ALL
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum AuditActorType {
  USER
  AGENT
  SYSTEM
  INTEGRATION
  PORTAL_CONTACT
}

// ─── Root (tenant) ───────────────────────────────────────────────────────────

/// The tenant boundary: one of our customers. Root table — not workspace-scoped itself.
model Workspace {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  timezone            String          @default("UTC")
  baseCurrency        String          @default("USD") @db.Char(3)
  status              WorkspaceStatus @default(ACTIVE)
  /// M5 setup wizard: true until an Admin finishes /setup and goes live. A pending workspace gets
  /// no nightly run (and no hourly Today/escalation sweep) until then.
  setupPending        Boolean         @default(false)
  dataRetentionDays   Int?
  deletionRequestedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  settings     WorkspaceSettings?
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]
  sessions     Session[]

  accounts            Account[]
  contacts            Contact[]
  stakeholderRoles    StakeholderRole[]
  contracts           Contract[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  revenueEvents       RevenueEvent[]
  usageDaily          UsageDaily[]
  userUsageDaily      UserUsageDaily[]
  featureUsage        FeatureUsageDaily[]
  featureCatalog      FeatureCatalog[]
  conversations       Conversation[]
  messages            Message[]
  tickets             Ticket[]
  transcripts         CallTranscript[]
  tasks               Task[]
  noteTemplates       NoteTemplate[]
  notes               Note[]
  notifications       Notification[]
  segments            Segment[]
  files               FileObject[]
  externalRefs        ExternalRef[]
  importJobs          ImportJob[]
  missingPrompts      MissingDataPrompt[]
  dataIssues          DataQualityIssue[]
  healthModels        HealthModel[]
  healthSnapshots     HealthScoreSnapshot[]
  healthReasons       HealthReason[]
  pulses              CsmPulse[]
  usageBaselines      UsageBaseline[]
  signalRules         SignalRule[]
  signals             Signal[]
  outcomes            OutcomeRecord[]
  agentDefinitions    AgentDefinition[]
  agentRuns           AgentRun[]
  approvals           Approval[]
  draftRevisions      DraftRevision[]
  outboundMessages    OutboundMessage[]
  suppressions        EmailSuppression[]
  todayItems          TodayItem[]
  extractions         Extraction[]
  integrations        Integration[]
  syncJobs            SyncJob[]
  usageIngestBatches  UsageIngestBatch[]
  webhookEvents       WebhookEvent[]
  slackUserLinks      SlackUserLink[]
  onboardingTemplates OnboardingTemplate[]
  onboardingPlans     OnboardingPlan[]
  onboardingSteps     OnboardingStep[]
  goals               Goal[]
  renewals            Renewal[]
  renewalOutcomes     RenewalOutcome[]
  expansionOpps       ExpansionOpportunity[]
  documents           Document[]
  plays               Play[]
  playVersions        PlayVersion[]
  playRuns            PlayRun[]
  playStepRuns        PlayStepRun[]
  voiceSamples        VoiceSample[]
  campaigns           Campaign[]
  campaignRecipients  CampaignRecipient[]
  promises            Promise[]
  inboxItems          InboxItem[]
  unmatchedInbounds   UnmatchedInbound[]
  meetings            Meeting[]
  meetingAttendees    MeetingAttendee[]
  reportSnapshots     ReportSnapshot[]
  askThreads          AskThread[]
  askMessages         AskMessage[]
  successPlans        SuccessPlan[]
  surveys             Survey[]
  surveyResponses     SurveyResponse[]
  portalAccesses      PortalAccess[]
}

// ─── Global identity (Auth.js) ───────────────────────────────────────────────

/// [G] A person who can sign in. Email is stored lower-cased.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// argon2id hash for credentials sign-in; null for Google-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authAccounts      AuthAccount[]
  sessions          Session[]
  memberships       Membership[]
  organizedMeetings Meeting[]         @relation("MeetingOrganizer")
  askThreads        AskThread[]
  meetingAttendees  MeetingAttendee[]
}

/// [G] Auth.js linked OAuth account. Named AuthAccount so `Account` stays the customer
/// account (DECISIONS D-08). Token columns hold ciphertext from src/lib/crypto.
model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// [G] Database session (DECISIONS D-07). activeWorkspaceId drives workspace context.
model Session {
  id                String   @id @default(cuid())
  sessionToken      String   @unique
  userId            String
  expires           DateTime
  activeWorkspaceId String?
  createdAt         DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// [G] Auth.js verification tokens (email sign-in flows).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspace-scoped [W] ────────────────────────────────────────────────────

/// [W] A user's role in one workspace (ARCHITECTURE §7.2).
model Membership {
  id             String           @id @default(cuid())
  workspaceId    String
  userId         String
  role           Role
  canViewRevenue Boolean          @default(false)
  bookScope      BookScope        @default(OWN)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationsCreated    Invitation[]           @relation("InvitedBy")
  ownedAccounts         Account[]              @relation("AccountOwner")
  sentMessages          Message[]              @relation("MessageFromMember")
  ownedTasks            Task[]                 @relation("TaskOwner")
  createdTasks          Task[]                 @relation("TaskCreator")
  notes                 Note[]                 @relation("NoteAuthor")
  notifications         Notification[]         @relation("NotificationRecipient")
  segments              Segment[]              @relation("SegmentCreator")
  uploadedFiles         FileObject[]           @relation("FileUploader")
  importJobs            ImportJob[]            @relation("ImportCreator")
  missingPrompts        MissingDataPrompt[]    @relation("PromptAskedTo")
  publishedPlayVersions PlayVersion[]          @relation("PlayVersionPublisher")
  healthModelsMade      HealthModel[]          @relation("HealthModelCreator")
  healthModelsOked      HealthModel[]          @relation("HealthModelApprover")
  pulses                CsmPulse[]             @relation("PulseAuthor")
  signalRulesEdited     SignalRule[]           @relation("SignalRuleEditor")
  signalsAcked          Signal[]               @relation("SignalAcknowledger")
  signalsFalse          Signal[]               @relation("SignalFalseAlarm")
  signalsCreated        Signal[]               @relation("SignalCreator")
  approvalsAssigned     Approval[]             @relation("ApprovalAssignee")
  approvalsDecided      Approval[]             @relation("ApprovalDecider")
  approvalsProposed     Approval[]             @relation("ApprovalProposer")
  draftRevisions        DraftRevision[]        @relation("DraftEditor")
  reportsGenerated      ReportSnapshot[]       @relation("ReportGenerator")
  askThreads            AskThread[]            @relation("AskThreadMember")
  outboundCreated       OutboundMessage[]      @relation("OutboundCreator")
  todayItems            TodayItem[]
  integrationsMade      Integration[]          @relation("IntegrationConnector")
  stepsOwned            OnboardingStep[]       @relation("StepOwner")
  stepsCompleted        OnboardingStep[]       @relation("StepCompleter")
  goalsCreated          Goal[]                 @relation("GoalCreator")
  promisesOwned         Promise[]              @relation("PromiseOwner")
  promisesCreated       Promise[]              @relation("PromiseCreator")
  inboxAssigned         InboxItem[]            @relation("InboxAssignee")
  unmatchedDecided      UnmatchedInbound[]     @relation("UnmatchedDecider")
  renewalsCategorised   Renewal[]              @relation("RenewalCategoriser")
  renewalOutcomesBy     RenewalOutcome[]       @relation("RenewalOutcomeRecorder")
  expansionOwned        ExpansionOpportunity[] @relation("ExpansionOwner")
  slackLinks            SlackUserLink[]
  createdVoiceSamples   VoiceSample[]          @relation("VoiceSampleCreator")
  campaignsCreated      Campaign[]             @relation("CampaignCreator")

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId])
}

/// [W] A pending invitation. Only the SHA-256 of the token is stored.
model Invitation {
  id                    String    @id @default(cuid())
  workspaceId           String
  email                 String
  role                  Role
  canViewRevenue        Boolean   @default(false)
  bookScope             BookScope @default(OWN)
  tokenHash             String    @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedUserId        String?
  revokedAt             DateTime?
  invitedByMembershipId String
  createdAt             DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Composite FK: the inviter must be a member of the same workspace (ARCHITECTURE §3.1).
  invitedBy Membership @relation("InvitedBy", fields: [workspaceId, invitedByMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, email])
}

/// [W] Zod-typed workspace settings (src/modules/settings/schemas.ts).
model WorkspaceSettings {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  data        Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
}

/// [W] Append-only audit trail (Rule 5, spec §6N2). UPDATE/DELETE are blocked by a trigger.
model AuditLog {
  id          String         @id @default(cuid())
  workspaceId String
  actorType   AuditActorType
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  /// AgentRun id once agents exist (M4); plain column until then.
  agentRunId  String?
  summary     String
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agentRun  AgentRun? @relation("AuditAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
}

// ─── Global infrastructure ───────────────────────────────────────────────────

/// [G*] Transactional outbox (D-22). Read only by the worker dispatcher, which re-scopes
/// every handler with the event's workspaceId.
model OutboxEvent {
  id          String    @id @default(cuid())
  workspaceId String
  type        String
  payload     Json
  availableAt DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([processedAt, availableAt])
}

// ─── M2: Accounts & people ───────────────────────────────────────────────────

enum AccountTier {
  HIGH_TOUCH
  MID_TOUCH
  LONG_TAIL
}

enum TierSource {
  RULE
  MANUAL
}

enum LifecycleStage {
  ONBOARDING
  ADOPTING
  MATURE
  RENEWING
  LOST
}

/// Where a record came from (ARCHITECTURE §3.1). Connector values are added with their milestone.
enum RecordSource {
  CSV
  MANUAL
  SEED
  SYSTEM
  HUBSPOT
  SALESFORCE
  STRIPE
  CHARGEBEE
  USAGE_API
  MIXPANEL
  AMPLITUDE
  ZENDESK
  FRESHDESK
  GMAIL
  MICROSOFT_EMAIL
  GOOGLE_CALENDAR
  MICROSOFT_CALENDAR
  FIREFLIES
  GONG
  ZOOM
}

/// Who wrote a record. origin = AI requires agentRunId (Rule 5, DB CHECK).
enum RecordOrigin {
  HUMAN
  SYSTEM
  AI
  IMPORT
}

enum ContactStatus {
  ACTIVE
  BOUNCED
  LEFT
  UNKNOWN
}

enum StakeholderRoleType {
  CHAMPION
  DECISION_MAKER
  DAILY_USER
  EXEC_SPONSOR
  BILLING
  OTHER
}

/// [W] One of our customer's customers — the centre of the Account Graph (spec §6A1).
model Account {
  id                      String         @id @default(cuid())
  workspaceId             String
  name                    String
  domain                  String?
  tier                    AccountTier
  tierSource              TierSource     @default(RULE)
  lifecycleStage          LifecycleStage @default(ADOPTING)
  stageChangedAt          DateTime?
  onboardingStartedAt     DateTime?
  churnedAt               DateTime?
  ownerMembershipId       String?
  plan                    String?
  industry                String?
  employeeBand            String?
  useCase                 String?
  timezone                String?
  /// Derived from the active contract (billing service). Null = no contract on file, never 0.
  arrMinor                BigInt?
  arrCurrency             String?        @db.Char(3)
  /// Derived from the current contract; null = no renewal date on file.
  renewalDate             DateTime?
  lastTouchAt             DateTime?
  /// The latest live snapshot under the active model (ARCHITECTURE §11 cache).
  currentHealthSnapshotId String?
  source                  RecordSource   @default(MANUAL)
  /// Which source last set each field, e.g. {"domain":"HUBSPOT"} (Q-32 provenance, M5 D1).
  /// A field missing here was set by `source`.
  fieldSources            Json           @default("{}")
  archivedAt              DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner              Membership?            @relation("AccountOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)
  contacts           Contact[]
  stakeholderRoles   StakeholderRole[]
  contracts          Contract[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  revenueEvents      RevenueEvent[]
  usageDaily         UsageDaily[]
  userUsageDaily     UserUsageDaily[]
  featureUsage       FeatureUsageDaily[]
  conversations      Conversation[]
  messages           Message[]
  tickets            Ticket[]
  transcripts        CallTranscript[]
  tasks              Task[]
  notes              Note[]
  files              FileObject[]
  missingPrompts     MissingDataPrompt[]
  dataIssues         DataQualityIssue[]
  healthSnapshots    HealthScoreSnapshot[]  @relation("AccountSnapshots")
  currentHealth      HealthScoreSnapshot?   @relation("AccountCurrentSnapshot", fields: [workspaceId, currentHealthSnapshotId], references: [workspaceId, id], onDelete: NoAction)
  pulses             CsmPulse[]
  usageBaselines     UsageBaseline[]
  signals            Signal[]
  outcomes           OutcomeRecord[]
  agentRuns          AgentRun[]
  approvals          Approval[]
  outboundMessages   OutboundMessage[]
  todayItems         TodayItem[]
  extractions        Extraction[]
  onboardingPlans    OnboardingPlan[]
  goals              Goal[]
  promises           Promise[]
  inboxItems         InboxItem[]
  unmatchedInbound   UnmatchedInbound[]
  renewals           Renewal[]
  renewalOutcomes    RenewalOutcome[]
  expansionOpps      ExpansionOpportunity[]
  documents          Document[]
  playRuns           PlayRun[]
  campaignRecipients CampaignRecipient[]
  meetings           Meeting[]
  successPlans       SuccessPlan[]
  surveyResponses    SurveyResponse[]
  portalAccesses     PortalAccess[]

  @@unique([workspaceId, id])
  @@index([workspaceId, renewalDate])
  @@index([workspaceId, ownerMembershipId])
  @@index([workspaceId, tier])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, name])
  @@index([workspaceId, domain])
  @@index([workspaceId, arrMinor])
  @@index([workspaceId, lastTouchAt])
}

/// [W] A person at an account (spec §6A2).
model Contact {
  id              String        @id @default(cuid())
  workspaceId     String
  accountId       String
  name            String
  email           String?
  title           String?
  /// The title before the last change, and when it changed (M9, set by the database on a real change).
  previousTitle   String?
  titleChangedAt  DateTime?
  timezone        String?
  status          ContactStatus @default(ACTIVE)
  /// When `status` last changed (D-56). Set by the database on a real change unless given.
  statusChangedAt DateTime?
  /// The customer's own id for this person in product usage data (links UserUsageDaily rows).
  externalUserId  String?
  lastContactAt   DateTime?
  source          RecordSource  @default(MANUAL)
  /// Which source last set each field (Q-32 provenance, M5 D1). Missing = `source`.
  fieldSources    Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account            Account             @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  roles              StakeholderRole[]
  usage              UserUsageDaily[]
  messages           Message[]
  tickets            Ticket[]
  outboundMessages   OutboundMessage[]
  stepsOwned         OnboardingStep[]
  campaignRecipients CampaignRecipient[]
  meetingAttendees   MeetingAttendee[]
  surveyResponses    SurveyResponse[]
  portalAccesses     PortalAccess[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
  @@index([workspaceId, email])
}

/// [W] A contact's role over time (champion, decision maker…). History is kept for back-tests.
model StakeholderRole {
  id                String              @id @default(cuid())
  workspaceId       String
  accountId         String
  contactId         String
  role              StakeholderRoleType
  validFrom         DateTime
  validTo           DateTime?
  setByMembershipId String?
  origin            RecordOrigin        @default(HUMAN)
  /// AgentRun id; FK added in M4 (CHECK origin <> AI OR agentRunId IS NOT NULL).
  agentRunId        String?
  createdAt         DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  agentRun  AgentRun? @relation("StakeholderRoleAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, role, validTo])
  @@index([workspaceId, contactId])
}

// ─── M2: Commercial ──────────────────────────────────────────────────────────

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  ENDED
}

enum InvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
  UNCOLLECTIBLE
}

enum RevenueEventType {
  NEW
  EXPANSION
  CONTRACTION
  CHURN
  REACTIVATION
}

enum ComputedBy {
  RULE
}

/// [W] Contract & commercial record (spec §6A3). Terms and pricing notes are encrypted (INTERP-4).
model Contract {
  id               String         @id @default(cuid())
  workspaceId      String
  accountId        String
  startDate        DateTime
  endDate          DateTime?
  /// Null = no renewal date on file (the missing-data helper asks for it).
  renewalDate      DateTime?
  autoRenew        Boolean?
  noticePeriodDays Int?
  /// Annual value in minor units. Null = value not on file (never treated as 0).
  valueMinor       BigInt?
  currency         String         @default("USD") @db.Char(3)
  seatsPurchased   Int?
  creditsPurchased Int?
  termsEnc         String?
  pricingNotesEnc  String?
  status           ContractStatus @default(ACTIVE)
  /// The signed contract document (composite FK to FileObject).
  documentFileId   String?
  source           RecordSource   @default(MANUAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  subscriptions Subscription[]
  renewals      Renewal[]
  document      FileObject?    @relation(fields: [workspaceId, documentFileId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, startDate])
  @@index([workspaceId, renewalDate])
}

/// [W] A billing subscription (Stripe/Chargebee in M5; CSV/seed now).
model Subscription {
  id               String             @id @default(cuid())
  workspaceId      String
  accountId        String
  contractId       String?
  plan             String
  interval         BillingInterval
  amountMinor      BigInt
  currency         String             @default("USD") @db.Char(3)
  quantity         Int                @default(1)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  source           RecordSource       @default(MANUAL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contract  Contract? @relation(fields: [workspaceId, contractId], references: [workspaceId, id], onDelete: SetNull)
  invoices  Invoice[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

/// [W] An invoice and its payment outcome.
model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  accountId      String
  subscriptionId String?
  number         String
  amountMinor    BigInt
  currency       String        @default("USD") @db.Char(3)
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  status         InvoiceStatus @default(OPEN)
  failureCount   Int           @default(0)
  lastFailedAt   DateTime?
  source         RecordSource  @default(MANUAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [workspaceId, subscriptionId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, accountId, issuedAt])
}

/// [W] ARR movement derived by rule from contracts (never typed in, never from an LLM).
model RevenueEvent {
  id            String           @id @default(cuid())
  workspaceId   String
  accountId     String
  type          RevenueEventType
  deltaArrMinor BigInt
  currency      String           @db.Char(3)
  effectiveDate DateTime
  sourceType    String
  sourceId      String
  computedBy    ComputedBy       @default(RULE)
  createdAt     DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceType, sourceId, type])
  @@index([workspaceId, effectiveDate])
  @@index([workspaceId, accountId])
}

// ─── M2: Usage (daily aggregates only, D-23) ─────────────────────────────────

/// [W] Account-level product usage per day.
model UsageDaily {
  id          String       @id @default(cuid())
  workspaceId String
  accountId   String
  date        DateTime     @db.Date
  activeUsers Int
  sessions    Int
  events      Int
  seatsUsed   Int?
  creditsUsed Int?
  source      RecordSource @default(MANUAL)
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, date])
}

/// [W] Per-user product usage per day. contactId links to a known person when we have one.
model UserUsageDaily {
  id             String       @id @default(cuid())
  workspaceId    String
  accountId      String
  contactId      String?
  externalUserId String
  date           DateTime     @db.Date
  events         Int
  sessions       Int
  source         RecordSource @default(MANUAL)
  createdAt      DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, externalUserId, date])
  @@index([workspaceId, accountId, date])
}

/// [W] Per-feature product usage per day.
model FeatureUsageDaily {
  id          String       @id @default(cuid())
  workspaceId String
  accountId   String
  featureKey  String
  date        DateTime     @db.Date
  users       Int
  events      Int
  source      RecordSource @default(MANUAL)
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, featureKey, date])
}

/// [W] The customer's product features, which are key, and which plans include them.
model FeatureCatalog {
  id              String   @id @default(cuid())
  workspaceId     String
  featureKey      String
  label           String
  isKeyFeature    Boolean  @default(false)
  includedInPlans String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, featureKey])
}

// ─── M2: Support & conversations ─────────────────────────────────────────────

enum TicketStatus {
  OPEN
  PENDING
  SOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationChannel {
  EMAIL
  CALL
  CHAT
  TICKET
  MEETING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SentimentLabel {
  NEGATIVE
  NEUTRAL
  POSITIVE
  MIXED
}

/// [W] A thread of messages with an account (email thread, call, chat, ticket thread).
model Conversation {
  id               String              @id @default(cuid())
  workspaceId      String
  accountId        String
  channel          ConversationChannel
  subject          String?
  startedAt        DateTime
  lastMessageAt    DateTime
  externalThreadId String?
  source           RecordSource        @default(MANUAL)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  messages    Message[]
  tickets     Ticket[]
  transcripts CallTranscript[]
  meetings    Meeting[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, lastMessageAt])
}

/// [W] One message. The text is a source record that extraction (M4/M9) will read.
model Message {
  id                  String           @id @default(cuid())
  workspaceId         String
  conversationId      String
  accountId           String
  direction           MessageDirection
  fromContactId       String?
  fromMembershipId    String?
  fromAddress         String?
  toAddresses         String[]
  sentAt              DateTime
  subject             String?
  bodyText            String
  bodyStorageKey      String?
  /// Written only by an AI run (M4/M9): a label without its AgentRun is rejected (DB CHECK).
  sentimentLabel      SentimentLabel?
  sentimentAgentRunId String?
  source              RecordSource     @default(MANUAL)
  createdAt           DateTime         @default(now())

  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  account           Account      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  fromContact       Contact?     @relation(fields: [workspaceId, fromContactId], references: [workspaceId, id], onDelete: SetNull)
  fromMember        Membership?  @relation("MessageFromMember", fields: [workspaceId, fromMembershipId], references: [workspaceId, id], onDelete: SetNull)
  sentimentAgentRun AgentRun?    @relation("MessageSentimentRun", fields: [workspaceId, sentimentAgentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, sentAt])
  @@index([workspaceId, conversationId, sentAt])
}

/// [W] A support ticket (Zendesk/Freshdesk in M9; CSV/seed now). Its thread is a Conversation.
model Ticket {
  id                String          @id @default(cuid())
  workspaceId       String
  accountId         String
  contactId         String?
  conversationId    String?
  externalId        String?
  subject           String
  status            TicketStatus    @default(OPEN)
  priority          TicketPriority  @default(NORMAL)
  isEscalated       Boolean         @default(false)
  /// When the ticket was escalated (D-56). Set by the database on escalation unless given.
  escalatedAt       DateTime?
  /// Priority when opened, and when it last changed (D-64): a back-test reads the priority as of
  /// its date. Set by the database unless given.
  openingPriority   TicketPriority?
  priorityChangedAt DateTime?
  openedAt          DateTime
  firstResponseAt   DateTime?
  closedAt          DateTime?
  source            RecordSource    @default(MANUAL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, status])
  @@index([workspaceId, openedAt])
}

/// [W] A call transcript (Fireflies/Gong/Zoom in M10; seed/upload now). Read-only in M2.
model CallTranscript {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  accountId      String
  title          String
  provider       String
  language       String       @default("en")
  occurredAt     DateTime
  text           String
  segments       Json?
  durationSec    Int?
  source         RecordSource @default(MANUAL)
  createdAt      DateTime     @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  account      Account      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, occurredAt])
}

// ─── M2: Work — tasks, notes, notifications ──────────────────────────────────

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum NotificationChannel {
  IN_APP
  SLACK
}

enum NotificationType {
  MENTION
  TASK_ASSIGNED
  TASK_OVERDUE
  APPROVAL_ASSIGNED
  /// M5 (Slack): a big signal opened on an account the member owns.
  SIGNAL_OPENED
  /// M5 (Slack): the member's morning digest (refId = business date).
  DAILY_DIGEST
  /// M6: an onboarding plan on an account the member owns stalled (refId = plan id).
  ONBOARDING_STALLED
  /// M6: an onboarding plan reached first value (refId = plan id).
  ONBOARDING_VALUE_REACHED
  /// M11 (S7): this week's Leader Reporter digest is ready (refType ReportDigest, refId = the run id).
  LEADER_DIGEST
  /// M11 (S7): the digest could not be written; the reports are ready (refType ReportDigestNotice, refId = week start).
  LEADER_DIGEST_FAILED
}

/// [W] A unit of work for one member (spec §6F3). Agents and plays create tasks from M4/M8.
model Task {
  id                    String       @id @default(cuid())
  workspaceId           String
  accountId             String?
  signalId              String?
  title                 String
  detail                String?
  ownerMembershipId     String?
  createdByMembershipId String?
  dueAt                 DateTime?
  status                TaskStatus   @default(OPEN)
  priority              TaskPriority @default(NORMAL)
  completedAt           DateTime?
  escalatedAt           DateTime?
  origin                RecordOrigin @default(HUMAN)
  agentRunId            String?
  source                RecordSource @default(MANUAL)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  signal       Signal?       @relation(fields: [workspaceId, signalId], references: [workspaceId, id], onDelete: Restrict)
  owner        Membership?   @relation("TaskOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)
  createdBy    Membership?   @relation("TaskCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)
  agentRun     AgentRun?     @relation("TaskAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)
  playStepRuns PlayStepRun[]

  @@unique([workspaceId, id])
  @@index([workspaceId, ownerMembershipId, status, dueAt])
  @@index([workspaceId, accountId])
  @@index([workspaceId, signalId])
}

/// [W] A note template per call type (spec §6F4).
model NoteTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  callType    String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

/// [W] A note on an account, with tags and @mentions (spec §6F4).
model Note {
  id                   String       @id @default(cuid())
  workspaceId          String
  accountId            String
  authorMembershipId   String?
  templateId           String?
  body                 String
  tags                 String[]
  mentionMembershipIds String[]
  origin               RecordOrigin @default(HUMAN)
  agentRunId           String?
  source               RecordSource @default(MANUAL)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  author    Membership?   @relation("NoteAuthor", fields: [workspaceId, authorMembershipId], references: [workspaceId, id], onDelete: SetNull)
  template  NoteTemplate? @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: SetNull)
  agentRun  AgentRun?     @relation("NoteAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, createdAt])
}

/// [W] An in-app notification for one member.
model Notification {
  id                    String              @id @default(cuid())
  workspaceId           String
  recipientMembershipId String
  type                  NotificationType
  title                 String
  refType               String
  refId                 String
  accountId             String?
  /// Where it is delivered: the in-app bell, or the workspace's Slack (M5).
  channel               NotificationChannel @default(IN_APP)
  readAt                DateTime?
  createdAt             DateTime            @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Membership @relation("NotificationRecipient", fields: [workspaceId, recipientMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, recipientMembershipId, readAt])
}

/// [W] A saved account filter (spec §6F5). `filter` is the Zod-validated segment DSL (D-45).
model Segment {
  id                    String   @id @default(cuid())
  workspaceId           String
  name                  String
  filter                Json
  isDynamic             Boolean  @default(true)
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("SegmentCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)
  campaigns Campaign[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

// ─── M2: Files ───────────────────────────────────────────────────────────────

enum FilePurpose {
  CONTRACT_DOCUMENT
  CSV_IMPORT
  CALL_TRANSCRIPT
  ASK_ATTACHMENT
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
}

/// [W] An uploaded file. The storage key is generated by us under ws/<workspaceId>/ and is never
/// exposed; files are served only by /api/files/[id]/download after access checks (§7.6).
model FileObject {
  id                     String      @id @default(cuid())
  workspaceId            String
  accountId              String?
  purpose                FilePurpose
  storageKey             String      @unique
  filename               String
  mimeType               String
  sizeBytes              Int
  sha256                 String
  scanStatus             ScanStatus  @default(PENDING)
  uploadedByMembershipId String?
  createdAt              DateTime    @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  uploadedBy Membership? @relation("FileUploader", fields: [workspaceId, uploadedByMembershipId], references: [workspaceId, id], onDelete: SetNull)
  contracts  Contract[]
  importJobs ImportJob[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

// ─── M2: Import plumbing ─────────────────────────────────────────────────────

enum ImportKind {
  ACCOUNTS
  CONTACTS
  CONTRACTS
  INVOICES
  USAGE_ACCOUNT_DAILY
  USAGE_USER_DAILY
  USAGE_FEATURE_DAILY
  TICKETS
  TICKET_MESSAGES
  /// M3: public news about a customer (INTERP-6), deferred here from M2.
  OUTSIDE_SIGNALS
}

enum ImportStatus {
  UPLOADED
  PREVIEWED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// [W] Maps an outside id to our record, so re-imports update instead of duplicating
/// (ARCHITECTURE §8.1). Unique per workspace + source + record type + external id.
model ExternalRef {
  id            String       @id @default(cuid())
  workspaceId   String
  source        RecordSource
  objectType    String
  externalId    String
  internalType  String
  internalId    String
  /// Integration id once connectors exist (M5); null for CSV.
  integrationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, source, objectType, externalId])
  @@index([workspaceId, internalType, internalId])
}

/// [W] One CSV import: upload → mapping → preview (dry run) → confirm → background run → report.
model ImportJob {
  id                    String       @id @default(cuid())
  workspaceId           String
  kind                  ImportKind
  fileObjectId          String
  status                ImportStatus @default(UPLOADED)
  headers               String[]
  /// Our field key → the CSV column it reads from.
  mapping               Json
  rowsTotal             Int          @default(0)
  rowsValid             Int          @default(0)
  created               Int          @default(0)
  updated               Int          @default(0)
  unchanged             Int          @default(0)
  failed                Int          @default(0)
  /// Per-row problems in plain words (capped), plus the full count.
  report                Json?
  errorPlain            String?
  createdByMembershipId String?
  confirmedAt           DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      FileObject  @relation(fields: [workspaceId, fileObjectId], references: [workspaceId, id], onDelete: Restrict)
  createdBy Membership? @relation("ImportCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

enum MissingDataField {
  OWNER
  RENEWAL_DATE
  KEY_CONTACT
}

/// [W] The missing-data helper's memory per account + field: when it was last shown, to whom,
/// and whether it was answered or snoozed (spec §6A5).
model MissingDataPrompt {
  id                     String           @id @default(cuid())
  workspaceId            String
  accountId              String
  field                  MissingDataField
  askedMembershipId      String?
  askedAt                DateTime?
  answeredAt             DateTime?
  answeredByMembershipId String?
  skippedAt              DateTime?
  snoozeUntil            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account     @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  askedTo   Membership? @relation("PromptAskedTo", fields: [workspaceId, askedMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, field])
  @@index([workspaceId, askedMembershipId, askedAt])
}

enum DataQualityKind {
  DUPLICATE_ACCOUNT
  DUPLICATE_CONTACT
  INVALID_EMAIL
  STALE
  /// Two sources disagree on one field (Q-32, D1): nothing was overwritten.
  CONFLICT
  /// Revenue events and the contract in force disagree on an account's ARR (M7, D9); nothing was changed.
  ARR_MISMATCH
}

enum DataQualityStatus {
  OPEN
  FIXED
  DISMISSED
  RESOLVED
}

/// [W] A data problem for a person to review (spec §6A6). The suggested fix is applied only
/// after confirmation; RESOLVED means a later scan no longer found it.
model DataQualityIssue {
  id                  String            @id @default(cuid())
  workspaceId         String
  accountId           String?
  contactId           String?
  kind                DataQualityKind
  detail              String
  suggestedFix        Json
  dedupeKey           String
  status              DataQualityStatus @default(OPEN)
  fixedByMembershipId String?
  fixedAt             DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status])
}

// ─── M3: Health ──────────────────────────────────────────────────────────────

enum HealthModelStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum HealthModelOrigin {
  SYSTEM_DEFAULT
  BACKTEST_PROPOSAL
  HUMAN
}

enum RiskLevel {
  HEALTHY
  WATCH
  AT_RISK
  INSUFFICIENT_DATA
}

enum HealthPillar {
  ADOPTION
  ENGAGEMENT
  SUPPORT
  RELATIONSHIP
  COMMERCIAL
  SENTIMENT
}

enum ReasonDirection {
  UP
  DOWN
  NEUTRAL
}

enum ReasonKind {
  EVIDENCE
  MISSING_DATA
}

enum PulseValue {
  FINE
  WORRIED
}

/// [W] A versioned health model (ARCHITECTURE §4.5). Immutable once it leaves DRAFT (DB trigger):
/// edits create a new version, and every snapshot keeps the version that produced it.
model HealthModel {
  id                     String            @id @default(cuid())
  workspaceId            String
  version                Int
  status                 HealthModelStatus @default(DRAFT)
  proposedBy             HealthModelOrigin
  /// { ADOPTION: 0.30, … } — sums to 1 (Zod).
  pillarWeights          Json
  /// Component weights and curves per pillar (Zod, src/modules/health/engine/model.ts).
  componentConfig        Json
  /// { healthyMin, watchMin }
  thresholds             Json
  /// { HIGH_TOUCH?: { healthyMin, watchMin }, … }
  perTierOverrides       Json              @default("{}")
  backtestResult         Json?
  basedOnVersion         Int?
  note                   String?
  createdByMembershipId  String?
  approvedByMembershipId String?
  activatedAt            DateTime?
  retiredAt              DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  Membership?           @relation("HealthModelCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  approvedBy Membership?           @relation("HealthModelApprover", fields: [workspaceId, approvedByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  snapshots  HealthScoreSnapshot[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, version])
}

/// [W] One account's health as of one calendar date under one model version. Only
/// health.writeSnapshot() inserts these. Unique per (account, model version, date, back-test):
/// a model change writes new rows under the new version; the old rows never change (DB trigger).
model HealthScoreSnapshot {
  id                      String      @id @default(cuid())
  workspaceId             String
  accountId               String
  healthModelId           String
  asOf                    DateTime    @db.Date
  /// Each null = "no data" (never 0). Overall is null when fewer than 2 pillars have data.
  overall                 Decimal?    @db.Decimal(5, 2)
  adoption                Decimal?    @db.Decimal(5, 2)
  engagement              Decimal?    @db.Decimal(5, 2)
  support                 Decimal?    @db.Decimal(5, 2)
  relationship            Decimal?    @db.Decimal(5, 2)
  commercial              Decimal?    @db.Decimal(5, 2)
  sentiment               Decimal?    @db.Decimal(5, 2)
  overallExcludingPulse   Decimal?    @db.Decimal(5, 2)
  riskLevel               RiskLevel
  riskLevelExcludingPulse RiskLevel
  /// The most negative reason; must be one of THIS snapshot's own reasons (deferred FK).
  riskReasonId            String?
  pulseValue              PulseValue?
  pulseId                 String?
  pulseDisagreement       Boolean     @default(false)
  /// Weights after renormalisation over the pillars that have data (shown in Why).
  effectiveWeights        Json
  inputsHash              String
  isBacktest              Boolean     @default(false)
  createdAt               DateTime    @default(now())

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account        @relation("AccountSnapshots", fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  healthModel HealthModel    @relation(fields: [workspaceId, healthModelId], references: [workspaceId, id], onDelete: Restrict)
  riskReason  HealthReason?  @relation("SnapshotRiskReason", fields: [workspaceId, id, riskReasonId], references: [workspaceId, snapshotId, id], onDelete: NoAction, onUpdate: NoAction)
  pulse       CsmPulse?      @relation(fields: [workspaceId, pulseId], references: [workspaceId, id], onDelete: Restrict)
  reasons     HealthReason[] @relation("SnapshotReasons")
  currentFor  Account[]      @relation("AccountCurrentSnapshot")

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, healthModelId, asOf, isBacktest])
  @@index([workspaceId, asOf, riskLevel])
}

/// [W] One reason behind a snapshot: the input, its value, the baseline it was compared with,
/// the delta, the source record ids and the dates (spec §6C2). Immutable.
model HealthReason {
  id          String          @id @default(cuid())
  workspaceId String
  snapshotId  String
  pillar      HealthPillar
  component   String
  kind        ReasonKind
  direction   ReasonDirection
  /// Signed points this reason moves the overall (they sum to overall − 100).
  impact      Decimal         @db.Decimal(6, 2)
  /// Component score 0–100; null for MISSING_DATA.
  score       Decimal?        @db.Decimal(5, 2)
  message     String
  input       String
  value       Decimal?        @db.Decimal(14, 4)
  baseline    Decimal?        @db.Decimal(14, 4)
  delta       Decimal?        @db.Decimal(14, 4)
  cohortValue Decimal?        @db.Decimal(14, 4)
  cohortKey   String?
  cohortSize  Int?
  periodStart DateTime?       @db.Date
  periodEnd   DateTime?       @db.Date
  /// [{ sourceType, sourceId } | { sourceType, accountId, from, to }] — ≥ 1 for EVIDENCE (DB CHECK).
  sources     Json            @default("[]")
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot      HealthScoreSnapshot   @relation("SnapshotReasons", fields: [workspaceId, snapshotId], references: [workspaceId, id], onDelete: Cascade)
  riskReasonFor HealthScoreSnapshot[] @relation("SnapshotRiskReason")

  @@unique([workspaceId, id])
  @@unique([workspaceId, snapshotId, id])
  @@index([workspaceId, snapshotId])
}

/// [W] A CSM's judgement on an account (spec §6C5, Q-07, Q-21). A real input to Relationship,
/// valid for 30 days, never a silent override.
model CsmPulse {
  id           String     @id @default(cuid())
  workspaceId  String
  accountId    String
  membershipId String
  value        PulseValue
  comment      String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    Account               @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  membership Membership            @relation("PulseAuthor", fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Restrict)
  snapshots  HealthScoreSnapshot[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, createdAt])
}

/// [W] An account's own normal and its cohort's, for one metric as of one date (ARCHITECTURE §4.2).
model UsageBaseline {
  id            String   @id @default(cuid())
  workspaceId   String
  accountId     String
  metric        String
  windowEnd     DateTime @db.Date
  accountMedian Decimal? @db.Decimal(14, 4)
  accountP25    Decimal? @db.Decimal(14, 4)
  historyDays   Int
  /// e.g. "tier=MID_TOUCH|plan=Growth" — the fallback level actually used.
  cohortKey     String?
  cohortMedian  Decimal? @db.Decimal(14, 4)
  cohortSize    Int      @default(0)
  computedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, metric, windowEnd])
}

// ─── M3: Signals ─────────────────────────────────────────────────────────────

enum SignalCategory {
  USAGE
  PEOPLE
  SUPPORT
  CALLS_EMAIL
  MONEY
  PROMISES
  OUTSIDE
}

enum SignalSeverity {
  INFO
  WARN
  CRITICAL
}

enum SignalPolarity {
  RISK
  OPPORTUNITY
}

enum SignalStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum OutcomeAction {
  ACTED
  IGNORED
  PENDING
}

/// [W] One rule from the code library per workspace (ARCHITECTURE §5.2), with the four spec §6D
/// fields and its thresholds. Editing params bumps `version` (audited); signals keep the version
/// that raised them. A dormant rule (no data source yet, D-61) cannot be enabled.
model SignalRule {
  id                    String         @id @default(cuid())
  workspaceId           String
  ruleKey               String
  category              SignalCategory
  polarity              SignalPolarity
  enabled               Boolean        @default(true)
  params                Json
  version               Int            @default(1)
  meaning               String
  howDetected           String
  typicalLeadTime       String
  falseAlarmCauses      String
  /// Why the rule cannot run yet, e.g. "Needs meeting data (arrives in M10)". Null = live.
  dormantReason         String?
  updatedByMembershipId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy Membership? @relation("SignalRuleEditor", fields: [workspaceId, updatedByMembershipId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, ruleKey])
}

/// [W] A signal with a lifecycle (M3 rule 8). Unique per (dedupeKey, episode) (D-57); the database
/// also allows at most one OPEN/ACKNOWLEDGED episode per dedupeKey, so re-runs cannot duplicate.
model Signal {
  id                    String         @id @default(cuid())
  workspaceId           String
  accountId             String
  ruleKey               String
  ruleVersion           Int
  category              SignalCategory
  severity              SignalSeverity
  polarity              SignalPolarity
  status                SignalStatus   @default(OPEN)
  title                 String
  explanation           String
  /// [{ sourceType, sourceId?, accountId?, from?, to?, value, date }] — ≥ 1 (DB CHECK).
  evidence              Json
  /// The numbers that fired it, and the thresholds used.
  values                Json
  params                Json
  dedupeKey             String
  episode               Int            @default(1)
  firstSeenAt           DateTime       @db.Date
  lastSeenAt            DateTime       @db.Date
  resolvedAt            DateTime?
  resolvedReason        String?
  acknowledgedById      String?
  acknowledgedAt        DateTime?
  markedFalseById       String?
  markedFalseAt         DateTime?
  falseAlarmReason      String?
  /// Values when marked false alarm: "materially worse" is measured against these (D-53).
  falseAlarmValues      Json?
  origin                RecordOrigin   @default(SYSTEM)
  /// AgentRun id; FK added in M4 (CHECK origin <> AI OR agentRunId IS NOT NULL).
  agentRunId            String?
  publicSourceUrl       String?
  publicSourceDate      DateTime?      @db.Date
  createdByMembershipId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          Account           @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  acknowledgedBy   Membership?       @relation("SignalAcknowledger", fields: [workspaceId, acknowledgedById], references: [workspaceId, id], onDelete: Restrict)
  markedFalseBy    Membership?       @relation("SignalFalseAlarm", fields: [workspaceId, markedFalseById], references: [workspaceId, id], onDelete: Restrict)
  createdBy        Membership?       @relation("SignalCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  outcome          OutcomeRecord?
  approvals        Approval[]
  outboundMessages OutboundMessage[]
  tasks            Task[]
  playRuns         PlayRun[]
  agentRun         AgentRun?         @relation("SignalAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, dedupeKey, episode])
  @@index([workspaceId, status, severity])
  @@index([workspaceId, accountId, firstSeenAt])
}

/// [W] "Did it work?" ledger row (spec §6L3, ARCHITECTURE §6.5). M3 creates it when a RISK or
/// OPPORTUNITY signal of WARN or above opens (one per episode); checkpoints arrive in M4/M7/M11.
model OutcomeRecord {
  id                 String         @id @default(cuid())
  workspaceId        String
  accountId          String
  signalId           String?
  agentRunId         String?
  flagType           SignalPolarity
  flaggedAt          DateTime
  /// ARR at the moment of the flag; null when the account has no ARR (never 0, Rule 4).
  arrAtFlagMinor     BigInt?
  arrCurrency        String?        @db.Char(3)
  actionTaken        OutcomeAction  @default(PENDING)
  actionRefs         Json           @default("[]")
  firstActionAt      DateTime?
  d7Outcome          Json?
  d30Outcome         Json?
  d90Outcome         Json?
  /// M7: what happened to revenue within 90 days of the flag (renewed / expanded / contracted /
  /// churned), from RenewalOutcome and revenue events, with evidence; attributed, not causal (Q-15).
  revenueOutcome     Json?
  valueSavedMinor    BigInt?
  valueExpandedMinor BigInt?
  isTrueAlarm        Boolean?
  csmAgreed          Boolean?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  signal    Signal?   @relation(fields: [workspaceId, signalId], references: [workspaceId, id], onDelete: Restrict)
  agentRun  AgentRun? @relation("OutcomeAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, signalId])
  @@index([workspaceId, flaggedAt])
}

// ─── M4: agents, approvals, outbound, today, extraction (ARCHITECTURE §3.2 "AI & approvals") ───

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  INVALID_OUTPUT
  UNCITED
  FAILED
  SKIPPED
}

enum AgentActionTaken {
  NONE
  DRAFTED
  APPROVAL_REQUESTED
  TASK_CREATED
  NOTIFIED
  EXECUTED
  SENT
}

/// [W] Per-workspace switch and overrides for one agent of the code registry (ARCHITECTURE §6.1).
model AgentDefinition {
  id                      String   @id @default(cuid())
  workspaceId             String
  agentKey                String
  codeVersion             String
  enabled                 Boolean  @default(true)
  /// { HIGH_TOUCH?: level, MID_TOUCH?: level, LONG_TAIL?: level }; can only lower a level.
  approvalPolicyOverrides Json     @default("{}")
  modelTierOverride       String?
  isCustom                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, agentKey])
}

/// [W] One execution of one agent: what it read, what it decided, what it did (Rule 5, §6E).
/// CHECK: status = SUCCEEDED ⇒ output, reasoningSummary, confidence, promptVersion, model NOT NULL.
model AgentRun {
  id               String           @id @default(cuid())
  workspaceId      String
  agentKey         String
  agentVersion     String
  promptName       String
  promptVersion    String?
  /// The model id the provider reported (never written in code; from env per tier).
  model            String?
  modelTier        String
  triggerType      String
  triggerId        String
  idempotencyKey   String
  /// The exact records the run was given: [{ sourceType, sourceId }].
  inputRefs        Json             @default("[]")
  accountId        String?
  status           AgentRunStatus   @default(QUEUED)
  attempt          Int              @default(0)
  output           Json?
  reasoningSummary String?
  confidence       Float?
  citations        Json?
  actionTaken      AgentActionTaken @default(NONE)
  /// Every record the run created or changed: [{ type, id }].
  effects          Json             @default("[]")
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  latencyMs        Int?
  errorCode        String?
  errorDetail      String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  approvals        Approval[]
  draftRevisions   DraftRevision[]
  outboundMessages OutboundMessage[]
  extractions      Extraction[]
  auditLogs        AuditLog[]        @relation("AuditAgentRun")
  stakeholderRoles StakeholderRole[] @relation("StakeholderRoleAgentRun")
  messages         Message[]         @relation("MessageSentimentRun")
  tasks            Task[]            @relation("TaskAgentRun")
  notes            Note[]            @relation("NoteAgentRun")
  signals          Signal[]          @relation("SignalAgentRun")
  outcomeRecords   OutcomeRecord[]   @relation("OutcomeAgentRun")
  goals            Goal[]            @relation("GoalAgentRun")
  promises         Promise[]         @relation("PromiseAgentRun")
  documents        Document[]        @relation("DocumentAgentRun")
  meetingSummaries Meeting[]         @relation("MeetingSummaryAgentRun")
  reportDigests    ReportSnapshot[]  @relation("ReportDigestRun")
  askMessages      AskMessage[]      @relation("AskMessageRun")
  playStepRuns     PlayStepRun[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, agentKey, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, accountId, agentKey, createdAt])
}

enum ApprovalKind {
  SEND_EMAIL
  CREATE_TASK
  UPDATE_FIELD
  ENROLL_PLAY
  BULK_ACTION
  WRITE_BACK
  CAMPAIGN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED_APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
  AUTO_RECORDED
}

/// ARCHITECTURE §7.3, in order (lowest first).
enum ApprovalLevel {
  NOTIFY_ONLY
  DRAFT_FOR_APPROVAL
  DRAFT_IN_MAILBOX
  DO_AUTOMATICALLY
  SEND_AUTOMATICALLY
}

/// Where a decision was made. Sensitive approvals are never decided from Slack (Q-31, DB CHECK).
enum DecisionChannel {
  APP
  SLACK
}

/// [W] A human yes/no on something an agent or person proposed (§6F2). The only door out (Rule 3).
model Approval {
  id                     String           @id @default(cuid())
  workspaceId            String
  accountId              String?
  kind                   ApprovalKind
  payload                Json             @default("{}")
  proposedByAgentRunId   String?
  proposedByMembershipId String?
  signalId               String?
  reason                 String
  /// [{ sourceType, sourceId, label? }] — at least one when an agent proposed it (DB CHECK).
  proof                  Json             @default("[]")
  status                 ApprovalStatus   @default(PENDING)
  decidedById            String?
  decidedAt              DateTime?
  decidedVia             DecisionChannel?
  decisionNote           String?
  /// { fromVersion, toVersion, subjectChanged, bodyChanged } when edited before approval.
  editDiff               Json?
  requiredLevel          ApprovalLevel
  isSensitive            Boolean          @default(false)
  sensitiveReasons       String[]
  assigneeId             String?
  /// Side-effect key `agentRunId:actionIndex` or `user:…`; unique so a retry never duplicates.
  sourceKey              String?
  expiresAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          Account?          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  proposedByRun    AgentRun?         @relation(fields: [workspaceId, proposedByAgentRunId], references: [workspaceId, id], onDelete: NoAction)
  proposedBy       Membership?       @relation("ApprovalProposer", fields: [workspaceId, proposedByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  decidedBy        Membership?       @relation("ApprovalDecider", fields: [workspaceId, decidedById], references: [workspaceId, id], onDelete: Restrict)
  assignee         Membership?       @relation("ApprovalAssignee", fields: [workspaceId, assigneeId], references: [workspaceId, id], onDelete: Restrict)
  signal           Signal?           @relation(fields: [workspaceId, signalId], references: [workspaceId, id], onDelete: Restrict)
  outboundMessages OutboundMessage[]
  revisions        DraftRevision[]
  playStepRuns     PlayStepRun[]
  campaign         Campaign?         @relation("CampaignApproval")

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, status, assigneeId])
  @@index([workspaceId, accountId])
}

/// [W] One immutable version of a customer draft. Editing writes a new version (never an overwrite).
model DraftRevision {
  id                String       @id @default(cuid())
  workspaceId       String
  approvalId        String
  outboundMessageId String
  version           Int
  subject           String
  bodyText          String
  editedById        String?
  origin            RecordOrigin @default(HUMAN)
  agentRunId        String?
  createdAt         DateTime     @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approval  Approval        @relation(fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: Cascade)
  outbound  OutboundMessage @relation(fields: [workspaceId, outboundMessageId], references: [workspaceId, id], onDelete: Cascade)
  editedBy  Membership?     @relation("DraftEditor", fields: [workspaceId, editedById], references: [workspaceId, id], onDelete: Restrict)
  agentRun  AgentRun?       @relation(fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, approvalId, version])
}

enum OutboundStatus {
  DRAFT
  AWAITING_APPROVAL
  QUEUED
  HELD
  SENT
  FAILED
  BOUNCED
  CANCELLED
}

enum SendMode {
  APPROVED
  AUTO
  CAMPAIGN
}

/// [W] A customer email. Only src/modules/outbound/dispatch.ts can send one (Rule 3, §7.4).
model OutboundMessage {
  id                    String         @id @default(cuid())
  workspaceId           String
  accountId             String
  contactId             String
  toEmail               String
  approvalId            String?
  campaignId            String?
  signalId              String?
  subject               String
  bodyText              String
  status                OutboundStatus @default(DRAFT)
  heldReason            String?
  sendMode              SendMode       @default(APPROVED)
  /// [{ guard, passed, detail }] from the last dispatch attempt.
  guardResults          Json           @default("[]")
  sentAt                DateTime?
  providerMessageId     String?
  transport             String?
  origin                RecordOrigin   @default(HUMAN)
  agentRunId            String?
  sourceKey             String?
  createdByMembershipId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account            Account             @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact            Contact             @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict)
  approval           Approval?           @relation(fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: Restrict)
  signal             Signal?             @relation(fields: [workspaceId, signalId], references: [workspaceId, id], onDelete: Restrict)
  agentRun           AgentRun?           @relation(fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)
  createdBy          Membership?         @relation("OutboundCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  campaign           Campaign?           @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Cascade)
  revisions          DraftRevision[]
  playStepRuns       PlayStepRun[]
  voiceSamples       VoiceSample[]
  inboxItems         InboxItem[]         @relation("InboxDraft")
  campaignRecipients CampaignRecipient[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceKey])
  @@unique([workspaceId, approvalId])
  @@index([workspaceId, contactId, sentAt])
  @@index([workspaceId, accountId, sentAt])
  /// Created by the M8 campaigns migration; declared here in M12 A3 so schema and folder agree.
  @@index([workspaceId, campaignId])
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
}

/// [W] Addresses that must never receive customer email, approved sends included (guard 7).
/// `email` is stored lower-case (DB CHECK), so the unique is case-insensitive.
model EmailSuppression {
  id          String            @id @default(cuid())
  workspaceId String
  email       String
  reason      SuppressionReason
  note        String?
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, email])
}

enum TodayItemType {
  TASK
  SIGNAL
  MEETING
  APPROVAL
  RENEWAL
}

/// [W] Rebuildable cache of one member's ranked Today queue (ARCHITECTURE §9).
model TodayItem {
  id           String        @id @default(cuid())
  workspaceId  String
  membershipId String
  itemType     TodayItemType
  refId        String
  accountId    String?
  title        String
  rankScore    Float
  rankReasons  Json
  dueAt        DateTime?
  computedAt   DateTime

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  account    Account?   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, membershipId, itemType, refId])
  @@index([workspaceId, membershipId, itemType, rankScore])
}

enum ExtractionSourceType {
  MESSAGE
  TICKET
  CALL_TRANSCRIPT
  NOTE
  SURVEY_RESPONSE
  FILE
}

enum ExtractionKind {
  SENTIMENT
  COMPETITOR
  BUDGET_CONCERN
  PROMISE
  GOAL
  CANCEL_LANGUAGE
  EXPORT_LANGUAGE
  COMPLAINT
  RENEWAL_CONCERN
  ACTION_ITEM
  DECISION
  THEME
  INTENT
}

/// [W] One labelled item from a source text, with its verbatim quote verified against the source
/// before it was written (ARCHITECTURE §5.3, D-75). Idempotent per (source, promptVersion, index).
model Extraction {
  id            String               @id @default(cuid())
  workspaceId   String
  sourceType    ExtractionSourceType
  sourceId      String
  accountId     String
  kind          ExtractionKind
  payload       Json
  quote         String
  confidence    Float
  promptVersion String
  itemIndex     Int
  /// Which chunk of a long source (a call transcript) this item came from; 0 for a short source (M9, D-M9).
  chunkIndex    Int                  @default(0)
  /// e.g. "no_date" for a PROMISE whose date did not parse.
  flags         String[]
  origin        RecordOrigin         @default(AI)
  agentRunId    String
  createdAt     DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  agentRun  AgentRun  @relation(fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)
  goal      Goal?
  promise   Promise?

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceType, sourceId, promptVersion, chunkIndex, itemIndex])
  @@index([workspaceId, accountId, kind, createdAt])
  @@index([workspaceId, sourceType, sourceId])
}

// ─── M5: integrations ────────────────────────────────────────────────────────────────────

enum IntegrationProvider {
  HUBSPOT
  SALESFORCE
  STRIPE
  CHARGEBEE
  SLACK
  /// M6: our own usage ingest endpoint (Segment-compatible subset).
  USAGE_API
  MIXPANEL
  AMPLITUDE
  ZENDESK
  FRESHDESK
  GOOGLE_EMAIL
  MICROSOFT_EMAIL
  GOOGLE_CALENDAR
  MICROSOFT_CALENDAR
  FIREFLIES
  GONG
  ZOOM
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum SyncKind {
  FULL
  INCREMENTAL
  WEBHOOK
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SyncTrigger {
  NIGHTLY
  MANUAL
  SETUP
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// [W] One connected external system (ARCHITECTURE §3.2, §8). Read-only unless an Admin turns on
/// write-back for named fields (Rule 7). Credentials are sealed with the field cipher (§7.5) and
/// never leave the integrations module in plain text.
model Integration {
  id                      String              @id @default(cuid())
  workspaceId             String
  provider                IntegrationProvider
  status                  IntegrationStatus   @default(CONNECTED)
  /// AES-256-GCM JSON of tokens / API key / webhook secret (src/lib/crypto). Never logged.
  credentialsEnc          String?
  scopes                  String[]            @default([])
  /// The provider's own id for the connected account (portal, org, Stripe account, team).
  externalAccountId       String?
  writeBackEnabled        Boolean             @default(false)
  writeBackFields         String[]            @default([])
  connectedAt             DateTime            @default(now())
  connectedByMembershipId String?
  disconnectedAt          DateTime?
  lastSyncAt              DateTime?
  lastErrorPlain          String?
  /// USAGE_API only (M6 B1): SHA-256 of the ingest key. The key itself is shown once and never stored.
  ingestKeyHash           String?             @unique
  /// Last four characters of the key, the only part shown again.
  ingestKeyLast4          String?
  ingestKeyRotatedAt      DateTime?
  config                  Json                @default("{}")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy   Membership?        @relation("IntegrationConnector", fields: [workspaceId, connectedByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  syncJobs      SyncJob[]
  webhookEvents WebhookEvent[]
  externalRefs  ExternalRef[]
  slackLinks    SlackUserLink[]
  usageBatches  UsageIngestBatch[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, provider])
}

/// [W] Ledger of usage batches the aggregation job has applied (M6 B1, D-23/Q-33). It holds a hash and
/// counts, never an event: raw events live only in the queue job until they are folded into
/// UsageDaily / UserUsageDaily / FeatureUsageDaily. Re-processing a batch finds its key here and
/// changes nothing.
model UsageIngestBatch {
  id            String   @id @default(cuid())
  workspaceId   String
  integrationId String
  /// SHA-256 over the batch's event keys (messageId, else the event's own content).
  batchKey      String
  events        Int
  /// Events whose group matched no account in this workspace: {groupId, events}[] (capped).
  unmatched     Json     @default("[]")
  /// Day totals left as they were because another source owns them: plain-words reasons (capped).
  skipped       Json     @default("[]")
  appliedAt     DateTime @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, integrationId, batchKey])
  @@index([workspaceId, integrationId, appliedAt])
}

/// [W] One sync run of one integration. `cursor` is the provider cursor reached by this run; an
/// INCREMENTAL run resumes from the last SUCCEEDED run's cursor, and a failed page never moves it.
model SyncJob {
  id             String      @id @default(cuid())
  workspaceId    String
  integrationId  String
  kind           SyncKind
  trigger        SyncTrigger
  /// Dedupe key: one nightly run per business date, or a unique id for "Run sync now".
  runKey         String
  status         SyncStatus  @default(RUNNING)
  cursorIn       String?
  cursor         String?
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  counts         Json        @default("{}")
  errorPlain     String?
  errorDetailRef String?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, integrationId, runKey])
  @@index([workspaceId, integrationId, startedAt])
}

/// [W] One verified webhook delivery. Unverified payloads are never stored (M5 rule 4).
model WebhookEvent {
  id                String             @id @default(cuid())
  workspaceId       String
  integrationId     String
  externalEventId   String
  eventType         String
  payloadStorageKey String
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?
  status            WebhookEventStatus @default(RECEIVED)
  errorPlain        String?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, integrationId, externalEventId])
}

/// [W] A Slack user mapped to a member by verified email (M5, D-76). Decisions from Slack act as
/// this member and pass the same permission and book checks as the web UI.
model SlackUserLink {
  id            String   @id @default(cuid())
  workspaceId   String
  integrationId String
  slackUserId   String
  membershipId  String
  email         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  membership  Membership  @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, integrationId, slackUserId])
}

// ─── M6: onboarding ──────────────────────────────────────────────────────────────────────

enum OnboardingPlanStatus {
  ACTIVE
  STALLED
  COMPLETE
  CANCELLED
}

enum StepOwnerSide {
  US
  CUSTOMER
}

/// How a step was completed (M6 D1): a person, or a verified product event. Never a timer.
enum StepCompletion {
  HUMAN
  PRODUCT_EVENT
}

enum GoalStatus {
  OPEN
  ACHIEVED
  MISSED
  DROPPED
}

/// [W] A reusable onboarding plan (spec §6G1). `steps` and `valueDefinition` are validated by
/// src/modules/onboarding/schemas.ts; value is defined only over metrics the product measures.
model OnboardingTemplate {
  id              String       @id @default(cuid())
  workspaceId     String
  name            String
  forTier         AccountTier?
  forPlan         String?
  /// Days from start the template expects first value (the account's own target, D3).
  targetDays      Int
  steps           Json         @default("[]")
  valueDefinition Json         @default("[]")
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plans     OnboardingPlan[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

/// [W] One account's onboarding. At most one open (ACTIVE or STALLED) plan per account (DB index).
model OnboardingPlan {
  id              String               @id @default(cuid())
  workspaceId     String
  accountId       String
  templateId      String?
  startDate       DateTime             @db.Date
  targetValueDate DateTime             @db.Date
  /// First business date every value condition held (D3); null = not reached.
  valueReachedAt  DateTime?            @db.Date
  /// The usage rows that prove value was reached: [{sourceType, sourceId, value, date}].
  valueEvidence   Json                 @default("[]")
  status          OnboardingPlanStatus @default(ACTIVE)
  /// The likely blocker in plain words, from stall.ts (D2); null when not stalled.
  stallReason     String?
  /// Ranked blockers with sources, as stall.ts produced them.
  blockers        Json                 @default("[]")
  /// Sales handoff (handoff.ts): items, each with sources; "Not found in CRM" for missing ones.
  handoff         Json                 @default("{}")
  lastEvaluatedOn DateTime?            @db.Date
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account             @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  template  OnboardingTemplate? @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: NoAction)
  steps     OnboardingStep[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, accountId])
}

/// [W] One step of a plan. Done only by a person (HUMAN) or a verified product event with the
/// proving rows stored as evidence (PRODUCT_EVENT); DB CHECKs enforce both (D1).
model OnboardingStep {
  id                      String          @id @default(cuid())
  workspaceId             String
  planId                  String
  key                     String
  position                Int
  title                   String
  ownerSide               StepOwnerSide
  ownerMembershipId       String?
  ownerContactId          String?
  dueDate                 DateTime        @db.Date
  /// From the template: the product condition that completes this step on its own (D1).
  completesWhen           Json?
  doneAt                  DateTime?
  completedVia            StepCompletion?
  completedByMembershipId String?
  evidence                Json            @default("[]")
  blockedReason           String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan         OnboardingPlan @relation(fields: [workspaceId, planId], references: [workspaceId, id], onDelete: Cascade)
  owner        Membership?    @relation("StepOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)
  ownerContact Contact?       @relation(fields: [workspaceId, ownerContactId], references: [workspaceId, id], onDelete: NoAction)
  completedBy  Membership?    @relation("StepCompleter", fields: [workspaceId, completedByMembershipId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, planId, key])
  @@index([workspaceId, planId])
}

/// [W] A customer goal (spec §6G2, Architecture §3.2). M6 uses it for stated goals in the Sales
/// handoff; call-derived goals arrive in M9 and success plans in M10.
model Goal {
  id                    String       @id @default(cuid())
  workspaceId           String
  accountId             String
  successPlanId         String?
  text                  String
  metricKey             String?
  targetValue           Float?
  status                GoalStatus   @default(OPEN)
  sourceType            String?
  sourceId              String?
  quote                 String?
  /// The verified extraction this goal was made from (M9); at most one goal per extraction.
  extractionId          String?
  origin                RecordOrigin @default(HUMAN)
  agentRunId            String?
  createdByMembershipId String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  extraction  Extraction?  @relation(fields: [workspaceId, extractionId], references: [workspaceId, id], onDelete: SetNull)
  agentRun    AgentRun?    @relation("GoalAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)
  createdBy   Membership?  @relation("GoalCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  successPlan SuccessPlan? @relation(fields: [workspaceId, successPlanId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, extractionId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, successPlanId])
}

// ─── M7: Renewals, expansion, documents ──────────────────────────────────────

enum RenewalStage {
  UPCOMING
  IN_PROGRESS
  RENEWED
  CHURNED
}

enum ConfidenceBand {
  HIGH
  MEDIUM
  LOW
}

/// A human's forecast call (D3). Never overwritten by the computed confidence, and the computed
/// confidence is never overwritten by it: both are shown, and a disagreement is flagged.
enum ForecastCategory {
  COMMIT
  BEST_CASE
  AT_RISK
  OMITTED
}

enum RenewalResult {
  RENEWED
  CHURNED
}

enum OutcomeDetectedVia {
  CONTRACT_RECORDS
  HUMAN
}

/// [W] One renewal on the radar: a contract with a renewal date. `confidence` is deterministic
/// code over records (D-75): `confidenceReasons` lists every factor with its signed points and
/// sources. `forecastCategory` is the CSM's own call, audited, and separate.
model Renewal {
  id                        String            @id @default(cuid())
  workspaceId               String
  accountId                 String
  contractId                String
  renewalDate               DateTime          @db.Date
  /// renewalDate minus the contract's notice period; null when no notice period is on file.
  noticeDeadline            DateTime?         @db.Date
  /// The contract's annual value; null when not on file (never 0, Rule 4).
  arrAtRiskMinor            BigInt?
  currency                  String?           @db.Char(3)
  confidence                Int
  confidenceBand            ConfidenceBand
  /// [{ key, label, points, reason, sources[] }], the factors that moved it, plus the ones with no data.
  confidenceReasons         Json              @default("[]")
  /// The business date the confidence was computed for.
  confidenceAsOf            DateTime          @db.Date
  stage                     RenewalStage      @default(UPCOMING)
  forecastCategory          ForecastCategory?
  forecastNote              String?
  forecastSetByMembershipId String?
  forecastSetAt             DateTime?
  planSteps                 Json              @default("[]")
  briefDocumentId           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contract  Contract         @relation(fields: [workspaceId, contractId], references: [workspaceId, id], onDelete: Cascade)
  setBy     Membership?      @relation("RenewalCategoriser", fields: [workspaceId, forecastSetByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  brief     Document?        @relation("RenewalBrief", fields: [workspaceId, briefDocumentId], references: [workspaceId, id], onDelete: NoAction)
  outcomes  RenewalOutcome[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, contractId, renewalDate])
  @@index([workspaceId, renewalDate])
  @@index([workspaceId, accountId])
}

/// [W] What actually happened to a renewal, with what the forecast said at the time (M7 rule 7).
/// Append-only: a trigger refuses updates; a correction is a new row naming the one it replaces.
model RenewalOutcome {
  id                     String             @id @default(cuid())
  workspaceId            String
  renewalId              String
  accountId              String
  result                 RenewalResult
  occurredOn             DateTime           @db.Date
  /// ARR after the outcome: the new contract's value (null = not on file) or 0 when churned.
  outcomeArrMinor        BigInt?
  currency               String?            @db.Char(3)
  detectedVia            OutcomeDetectedVia
  recordedByMembershipId String?
  note                   String?
  /// The forecast as it stood on `forecastAsOf`: likelihood, band, the human's category, the
  /// ARR at risk and the reasons. Frozen here; never read back from the live Renewal.
  forecastConfidence     Int
  forecastBand           ConfidenceBand
  forecastCategory       ForecastCategory?
  forecastAsOf           DateTime           @db.Date
  forecastArrAtRiskMinor BigInt?
  forecastReasons        Json               @default("[]")
  /// The row this one corrects (a correction never edits the original).
  supersedesId           String?
  createdAt              DateTime           @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  renewal     Renewal          @relation(fields: [workspaceId, renewalId], references: [workspaceId, id], onDelete: Cascade)
  recordedBy  Membership?      @relation("RenewalOutcomeRecorder", fields: [workspaceId, recordedByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  supersedes  RenewalOutcome?  @relation("OutcomeCorrection", fields: [workspaceId, supersedesId], references: [workspaceId, id], onDelete: NoAction)
  corrections RenewalOutcome[] @relation("OutcomeCorrection")

  @@unique([workspaceId, id])
  @@index([workspaceId, renewalId])
  @@index([workspaceId, accountId, occurredOn])
}

enum ExpansionStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
  DISMISSED
}

enum ExpansionMethod {
  SEATS_OVER_LIMIT
  TIER_UPGRADE_DELTA
}

/// [W] An expansion opportunity found by a rule. The estimate is always an estimate and comes
/// only from the account's own prices; null = "No price on file".
model ExpansionOpportunity {
  id                String           @id @default(cuid())
  workspaceId       String
  accountId         String
  signalIds         String[]         @default([])
  estimateMinor     BigInt?
  currency          String?          @db.Char(3)
  estimateMethod    ExpansionMethod?
  isEstimate        Boolean          @default(true)
  ownerMembershipId String?
  nextStep          String?
  nextStepDate      DateTime?        @db.Date
  status            ExpansionStatus  @default(OPEN)
  crmExternalId     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account     @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  owner     Membership? @relation("ExpansionOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, status])
}

enum DocumentKind {
  RENEWAL_BRIEF
  QBR
  SUCCESS_PLAN
  PRE_CALL_BRIEF
}

/// [W] A generated document: `metrics` are locked numbers from code; `narrative` is text with
/// {{metric.key}} placeholders only (M7 B3), so no free-text number can drift from its source.
model Document {
  id          String       @id @default(cuid())
  workspaceId String
  accountId   String
  kind        DocumentKind
  title       String
  metrics     Json         @default("{}")
  narrative   Json         @default("[]")
  origin      RecordOrigin @default(SYSTEM)
  agentRunId  String?
  lockedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  agentRun      AgentRun? @relation("DocumentAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)
  renewals      Renewal[] @relation("RenewalBrief")
  meetingBriefs Meeting[] @relation("MeetingBrief")

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, kind])
}

// ─── M8: Plays Engine (spec §5, ARCHITECTURE §3.2) ────────────────────────────

enum PlayStatus {
  DRAFT
  PUBLISHED
  PAUSED
  KILLED
}

enum PlayRunStatus {
  RUNNING
  WAITING
  COMPLETED
  EXITED
  FAILED
}

enum PlayStepRunStatus {
  PENDING
  WAITING_APPROVAL
  DONE
  SKIPPED
  FAILED
}

/// [W] A play definition and lifecycle state (spec §5, ARCHITECTURE §3.2).
model Play {
  id               String     @id @default(cuid())
  workspaceId      String
  key              String
  name             String
  description      String?
  category         String     @default("general")
  status           PlayStatus @default(DRAFT)
  isSeeded         Boolean    @default(false)
  currentVersionId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentVersion PlayVersion?  @relation("PlayCurrentVersion", fields: [workspaceId, currentVersionId], references: [workspaceId, id], onDelete: SetNull)
  versions       PlayVersion[] @relation("PlayVersions")
  runs           PlayRun[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

/// [W] An immutable version of a Play's definition (spec §5, ARCHITECTURE §3.2).
model PlayVersion {
  id            String    @id @default(cuid())
  workspaceId   String
  playId        String
  version       Int
  definition    Json
  safetyCheck   Json?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  play           Play        @relation("PlayVersions", fields: [workspaceId, playId], references: [workspaceId, id], onDelete: Cascade)
  publishedBy    Membership? @relation("PlayVersionPublisher", fields: [workspaceId, publishedById], references: [workspaceId, id], onDelete: SetNull)
  runs           PlayRun[]
  currentForPlay Play[]      @relation("PlayCurrentVersion")

  @@unique([workspaceId, id])
  @@unique([workspaceId, playId, version])
  @@index([workspaceId, playId])
}

/// [W] A running execution of a play for an account (spec §5, ARCHITECTURE §3.2).
/// Unique on (playId, accountId, triggerRef) per D2; at most one OPEN run per play+account.
model PlayRun {
  id            String        @id @default(cuid())
  workspaceId   String
  playId        String
  playVersionId String
  accountId     String
  triggerRef    String
  signalId      String?
  status        PlayRunStatus @default(RUNNING)
  enteredAt     DateTime      @default(now())
  exitedAt      DateTime?
  exitReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  play      Play          @relation(fields: [workspaceId, playId], references: [workspaceId, id], onDelete: Cascade)
  version   PlayVersion   @relation(fields: [workspaceId, playVersionId], references: [workspaceId, id], onDelete: Restrict)
  account   Account       @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  signal    Signal?       @relation(fields: [workspaceId, signalId], references: [workspaceId, id], onDelete: SetNull)
  stepRuns  PlayStepRun[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, playId, accountId, triggerRef])
  @@index([workspaceId, playId, accountId, status])
  @@index([workspaceId, status])
}

/// [W] Execution record of an individual step in a play run (spec §5, ARCHITECTURE §3.2).
model PlayStepRun {
  id                String            @id @default(cuid())
  workspaceId       String
  playRunId         String
  stepKey           String
  handler           String
  status            PlayStepRunStatus @default(PENDING)
  scheduledFor      DateTime?
  approvalId        String?
  taskId            String?
  outboundMessageId String?
  agentRunId        String?
  result            Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playRun         PlayRun          @relation(fields: [workspaceId, playRunId], references: [workspaceId, id], onDelete: Cascade)
  approval        Approval?        @relation(fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: SetNull)
  task            Task?            @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: SetNull)
  outboundMessage OutboundMessage? @relation(fields: [workspaceId, outboundMessageId], references: [workspaceId, id], onDelete: SetNull)
  agentRun        AgentRun?        @relation(fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, playRunId, stepKey])
  @@index([workspaceId, status, scheduledFor])
}

/// [W] Approved email voice sample for in-prompt few-shot styling (spec §5, ARCHITECTURE §3.2, Rule 8).
model VoiceSample {
  id                String   @id @default(cuid())
  workspaceId       String
  outboundMessageId String?
  subject           String
  bodyText          String
  approvedForVoice  Boolean  @default(true)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outboundMessage OutboundMessage? @relation(fields: [workspaceId, outboundMessageId], references: [workspaceId, id], onDelete: SetNull)
  createdBy       Membership?      @relation("VoiceSampleCreator", fields: [workspaceId, createdById], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, approvedForVoice])
}

// ─── M8: Campaigns ────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum CampaignRecipientStatus {
  QUEUED
  HELD
  SENT
  FAILED
  BOUNCED
}

/// [W] A segment broadcast campaign (spec §6J2, ARCHITECTURE §3.2).
model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  segmentId   String
  subject     String
  body        String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  pacePerHour Int            @default(100)
  approvalId  String?        @unique
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segment          Segment             @relation(fields: [workspaceId, segmentId], references: [workspaceId, id], onDelete: Restrict)
  approval         Approval?           @relation("CampaignApproval", fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: Restrict)
  createdBy        Membership?         @relation("CampaignCreator", fields: [workspaceId, createdById], references: [workspaceId, id], onDelete: Restrict)
  recipients       CampaignRecipient[]
  outboundMessages OutboundMessage[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, approvalId])
  @@index([workspaceId, status, scheduledAt])
}

/// [W] One recipient of a segment campaign with delivery tracking (spec §6J2, ARCHITECTURE §3.2).
model CampaignRecipient {
  id                String                  @id @default(cuid())
  workspaceId       String
  campaignId        String
  contactId         String
  accountId         String
  outboundMessageId String?
  status            CampaignRecipientStatus @default(QUEUED)
  heldReason        String?
  guardResults      Json                    @default("[]")
  scheduledFor      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  unsubscribedAt    DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign        Campaign         @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Cascade)
  contact         Contact          @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  account         Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  outboundMessage OutboundMessage? @relation(fields: [workspaceId, outboundMessageId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, campaignId, contactId])
  @@index([workspaceId, status, scheduledFor])
}

// ─── M9: promises, inbox ─────────────────────────────────────────────────────────────────

enum PromiseParty {
  US
  CUSTOMER
  /// The text does not say who promised (D11): shown as "Not clear from the text".
  UNCLEAR
}

enum PromiseStatus {
  OPEN
  KEPT
  LATE
  BROKEN
}

/// [W] Something promised in a conversation, with its quote (M9, Rule 2). The LLM proposes it; the
/// status is written only by the promise status function, from dates and fulfilment evidence.
model Promise {
  id                    String                @id @default(cuid())
  workspaceId           String
  accountId             String
  party                 PromiseParty
  /// What the model guessed when the text did not settle `party`; shown as a flagged suggestion.
  suggestedParty        PromiseParty?
  what                  String
  /// The date the text names; null when it names none (never invented).
  dueDate               DateTime?             @db.Date
  ownerMembershipId     String?
  status                PromiseStatus         @default(OPEN)
  statusReason          String
  statusComputedAt      DateTime              @default(now())
  /// Fulfilment evidence a person (or a closed ticket) supplied: a record that shows it was kept.
  evidenceType          String?
  evidenceId            String?
  keptAt                DateTime?
  sourceType            ExtractionSourceType?
  sourceId              String?
  quote                 String?
  extractionId          String?
  /// sha256 of source + normalised quote (extraction origin) or a manual key: dedupe within an account.
  dedupeKey             String
  origin                RecordOrigin          @default(HUMAN)
  agentRunId            String?
  createdByMembershipId String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    Account     @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  owner      Membership? @relation("PromiseOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: SetNull)
  createdBy  Membership? @relation("PromiseCreator", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: SetNull)
  extraction Extraction? @relation(fields: [workspaceId, extractionId], references: [workspaceId, id], onDelete: SetNull)
  agentRun   AgentRun?   @relation("PromiseAgentRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, dedupeKey])
  @@unique([workspaceId, extractionId])
  @@index([workspaceId, accountId, status])
  @@index([workspaceId, status, dueDate])
}

enum InboxSourceType {
  MESSAGE
  TICKET
}

enum InboxStatus {
  NEW
  DRAFTED
  REPLIED
  CLOSED
}

enum InboxMatchedBy {
  /// The record already carried its account (a ticket, a thread we sent).
  SOURCE
  CONTACT_EMAIL
  DOMAIN
  MANUAL
}

/// [W] Triage state for one inbound message or ticket on a known account (M9, Rule 4: a view, not a
/// store). Intent and sentiment are read from Extraction; the text stays in its own record.
model InboxItem {
  id                     String          @id @default(cuid())
  workspaceId            String
  accountId              String
  sourceType             InboxSourceType
  sourceId               String
  status                 InboxStatus     @default(NEW)
  assigneeMembershipId   String?
  draftOutboundMessageId String?
  matchedBy              InboxMatchedBy
  receivedAt             DateTime
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  assignee  Membership?      @relation("InboxAssignee", fields: [workspaceId, assigneeMembershipId], references: [workspaceId, id], onDelete: SetNull)
  draft     OutboundMessage? @relation("InboxDraft", fields: [workspaceId, draftOutboundMessageId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceType, sourceId])
  @@index([workspaceId, status, receivedAt])
  @@index([workspaceId, accountId])
}

enum UnmatchedStatus {
  PENDING
  ASSIGNED
  DISMISSED
}

/// [W] Inbound mail nobody could match to exactly one account (M9, D2). The text lives here only
/// until a person assigns it (it then becomes a Conversation + Message and `bodyText` is cleared)
/// or dismisses it. Never auto-assigned.
model UnmatchedInbound {
  id                    String          @id @default(cuid())
  workspaceId           String
  provider              RecordSource
  externalId            String
  fromAddress           String
  toAddresses           String[]
  subject               String?
  /// Cleared (null) on assignment or dismissal so only one copy of the text ever exists.
  bodyText              String?
  receivedAt            DateTime
  /// Why it could not be placed, in plain words ("2 accounts share acme.com").
  reason                String
  candidateAccountIds   String[]
  status                UnmatchedStatus @default(PENDING)
  assignedAccountId     String?
  assignedMessageId     String?
  decidedByMembershipId String?
  decidedAt             DateTime?
  createdAt             DateTime        @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account?    @relation(fields: [workspaceId, assignedAccountId], references: [workspaceId, id], onDelete: SetNull)
  decidedBy Membership? @relation("UnmatchedDecider", fields: [workspaceId, decidedByMembershipId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, status, receivedAt])
}

// ─── M10: Meetings, QBR, Success Plans & Portal (spec §5, §6B, §6K, §7) ──────

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendeeResponseStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

/// [W] A meeting from a calendar integration or manual entry (spec §6B, §5).
model Meeting {
  id                String        @id @default(cuid())
  workspaceId       String
  accountId         String?
  externalId        String?
  title             String
  startsAt          DateTime
  endsAt            DateTime
  organizerUserId   String?
  conversationId    String?
  briefDocumentId   String?
  summaryAgentRunId String?
  source            RecordSource  @default(MANUAL)
  status            MeetingStatus @default(SCHEDULED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account?          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  organizer       User?             @relation("MeetingOrganizer", fields: [organizerUserId], references: [id], onDelete: SetNull)
  conversation    Conversation?     @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: SetNull)
  briefDocument   Document?         @relation("MeetingBrief", fields: [workspaceId, briefDocumentId], references: [workspaceId, id], onDelete: SetNull)
  summaryAgentRun AgentRun?         @relation("MeetingSummaryAgentRun", fields: [workspaceId, summaryAgentRunId], references: [workspaceId, id], onDelete: SetNull)
  attendees       MeetingAttendee[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId, startsAt])
  @@index([workspaceId, startsAt])
  @@index([workspaceId, source, externalId])
}

/// [W] An attendee of a meeting (spec §6B).
model MeetingAttendee {
  id             String                 @id @default(cuid())
  workspaceId    String
  meetingId      String
  contactId      String?
  userId         String?
  email          String
  name           String?
  responseStatus AttendeeResponseStatus @default(NEEDS_ACTION)
  createdAt      DateTime               @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [workspaceId, meetingId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, meetingId, email])
  @@index([workspaceId, meetingId])
  @@index([workspaceId, contactId])
}

enum SuccessPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// [W] A customer success plan (spec §5, §6K). Shared with the customer portal when enabled.
model SuccessPlan {
  id               String            @id @default(cuid())
  workspaceId      String
  accountId        String
  title            String
  status           SuccessPlanStatus @default(ACTIVE)
  sharedWithPortal Boolean           @default(false)
  milestones       Json              @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  goals     Goal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

enum SurveyType {
  NPS
  CSAT
  CES
}

enum SurveyTrigger {
  ONBOARDING_VALUE_REACHED
  TICKET_CLOSED
  RENEWAL_WINDOW_60
  MANUAL
}

enum SurveyStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// [W] A customer survey definition (spec §5, §6J5).
model Survey {
  id          String        @id @default(cuid())
  workspaceId String
  type        SurveyType
  trigger     SurveyTrigger
  question    String
  status      SurveyStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@unique([workspaceId, id])
  @@index([workspaceId, type, status])
}

/// [W] A response to a customer survey (spec §5, §6J5). Feeds Sentiment and Relationship pillars.
model SurveyResponse {
  id          String   @id @default(cuid())
  workspaceId String
  surveyId    String
  accountId   String
  contactId   String?
  score       Int
  comment     String?
  token       String?
  respondedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey    Survey    @relation(fields: [workspaceId, surveyId], references: [workspaceId, id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, token])
  @@index([workspaceId, accountId, respondedAt])
  @@index([workspaceId, surveyId])
}

/// [W] Magic-link access token for a customer contact to view their account portal (spec §5, §7).
/// Token is stored hashed (SHA-256) and expires (default 14 days, Decision 5). Revocable by CSM.
model PortalAccess {
  id          String    @id @default(cuid())
  workspaceId String
  accountId   String
  contactId   String
  tokenHash   String
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  contact   Contact   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, tokenHash])
  @@index([workspaceId, accountId])
  @@index([workspaceId, contactId])
}

// ─── M11: reports, Ask AI, outcome checkpoints (spec §6H, §6I) ───────────────

enum ReportTrigger {
  SCHEDULED
  MANUAL
}

enum AskRole {
  USER
  ASSISTANT
}

/// [W] One computed report for one period and filter set: a dated, immutable artefact (D-160).
/// DB trigger: reportKey, periodStart, periodEnd, filters, filtersHash, data and generatedAt never
/// change; digestAgentRunId may go from NULL to a value once.
model ReportSnapshot {
  id                      String        @id @default(cuid())
  workspaceId             String
  reportKey               String
  periodStart             DateTime      @db.Date
  periodEnd               DateTime      @db.Date
  filters                 Json          @default("{}")
  filtersHash             String
  data                    Json
  trigger                 ReportTrigger
  generatedByMembershipId String?
  generatedAt             DateTime
  digestAgentRunId        String?
  createdAt               DateTime      @default(now())

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy    Membership? @relation("ReportGenerator", fields: [workspaceId, generatedByMembershipId], references: [workspaceId, id], onDelete: SetNull)
  digestAgentRun AgentRun?   @relation("ReportDigestRun", fields: [workspaceId, digestAgentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, reportKey, periodEnd])
}

/// [W] One Ask AI conversation, private to the member who started it.
model AskThread {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  membershipId String
  title        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership   @relation("AskThreadMember", fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  messages   AskMessage[]

  @@unique([workspaceId, id])
  @@index([workspaceId, userId, createdAt])
}

/// [W] One message of an Ask thread. CHECK ask_message_agent_run_required: an ASSISTANT message
/// always names the AgentRun that produced it (Rule 5, no orphan AI text).
model AskMessage {
  id          String   @id @default(cuid())
  workspaceId String
  threadId    String
  role        AskRole
  content     String
  toolCalls   Json     @default("[]")
  citations   Json     @default("[]")
  agentRunId  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    AskThread @relation(fields: [workspaceId, threadId], references: [workspaceId, id], onDelete: Cascade)
  agentRun  AgentRun? @relation("AskMessageRun", fields: [workspaceId, agentRunId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, threadId, createdAt])
}
