// NexaWorks AI CSM — data model. Conventions: prisma/README.md and docs/ARCHITECTURE.md §3.
// Runtime connects as app_user (DATABASE_URL, subject to RLS); migrations run as the
// schema owner (DATABASE_URL_MIGRATE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}
