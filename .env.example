# Names only — never commit values (CLAUDE.md Rule 9). Copy to .env and fill locally.
# Format notes live in src/lib/config/env.ts.
NODE_ENV=
APP_URL=
DATABASE_URL=
DATABASE_URL_MIGRATE=
REDIS_URL=
QUEUE_PREFIX=
# "off" = the worker registers no nightly schedules (e2e only). Unset = on.
NIGHTLY_SCHEDULES=
# Deployment kind: production | staging | e2e (D-182). Test seams in a production build need
# APP_ENV=e2e AND a database whose name ends in _e2e; set by the e2e harness only.
APP_ENV=
# TEST-ONLY (e2e harness): multiplies every rate limit. Refused outside the e2e build.
RATE_LIMIT_SCALE=
# TEST-ONLY fake business clock (e2e harness). Ignored unless ALLOW_FAKE_CLOCK=true, and always
# ignored in production. Leave both unset in dev and production.
ALLOW_FAKE_CLOCK=
APP_FAKE_NOW=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL_FAST=
AI_MODEL_STANDARD=
AI_MODEL_DEEP=
# Recorded provider only (tests and demo replay; refused in production): where recordings live.
AI_RECORDINGS_DIR=
EMAIL_TRANSPORT=
EMAIL_FROM=
RESEND_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FIELD_ENCRYPTION_KEY=
LOG_LEVEL=
# Integrations (M5). live | fixture (fixture = recorded payloads; test/e2e/demo only, refused in production)
INTEGRATIONS_TRANSPORT=
# true = allow write-back pushes over the LIVE transport (unset = refused; D-116)
WRITE_BACK_LIVE=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_EMAIL_CLIENT_ID=
GOOGLE_EMAIL_CLIENT_SECRET=
MICROSOFT_EMAIL_CLIENT_ID=
MICROSOFT_EMAIL_CLIENT_SECRET=
# log | live (log = .dev-slack/ files; refused in production)
SLACK_DELIVERY=
# Dev demo:webhook script only; each integration stores its own webhook secret encrypted
STRIPE_WEBHOOK_SECRET=
# ClamAV clamd for upload scanning (Q-18). Production refuses to boot without CLAMD_HOST or CLAMD_SOCKET
CLAMD_HOST=
CLAMD_PORT=
CLAMD_SOCKET=
CLAMD_TIMEOUT_MS=
# Local services only (docker-compose.yml / scripts/services-native.sh)
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# Observability (M12 B4)
ERROR_TRACKING_DSN=
APP_RELEASE=
# Dev only: extra hosts (e.g. LAN IP) allowed to load the dev server, comma-separated
DEV_ALLOWED_ORIGINS=
