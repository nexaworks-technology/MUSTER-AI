{
  "provider": "slack",
  "description": "Bot OAuth exchange (fake token), auth.test for the Larkspur Slack team, and posting.",
  "interactions": [
    {
      "request": {
        "method": "POST",
        "path": "/api/oauth.v2.access",
        "bodyIncludes": "code="
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "ok": true,
          "access_token": "fixture-slack-bot-token-not-a-secret",
          "token_type": "bot",
          "scope": "chat:write,im:write,users:read,users:read.email",
          "bot_user_id": "UBOTLARK",
          "team": {
            "id": "TLARKSPUR1",
            "name": "Larkspur"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/auth.test"
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "ok": true,
          "url": "https://larkspur.slack.test/",
          "team": "Larkspur",
          "team_id": "TLARKSPUR1",
          "user_id": "UBOTLARK",
          "bot_id": "BLARK"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/chat.postMessage"
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "ok": true,
          "channel": "D0001",
          "ts": "1793700000.000100"
        }
      }
    }
  ]
}
