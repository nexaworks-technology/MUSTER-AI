{
  "provider": "hubspot",
  "description": "OAuth token exchange and refresh with obviously fake tokens; account details.",
  "interactions": [
    {
      "request": {
        "method": "POST",
        "path": "/oauth/v1/token",
        "bodyIncludes": "grant_type=authorization_code"
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "access_token": "fixture-access-token-not-a-secret",
          "refresh_token": "fixture-refresh-token-not-a-secret",
          "expires_in": 1800,
          "token_type": "bearer"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/oauth/v1/token",
        "bodyIncludes": "grant_type=refresh_token"
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "access_token": "fixture-access-token-refreshed",
          "refresh_token": "fixture-refresh-token-not-a-secret",
          "expires_in": 1800,
          "token_type": "bearer"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/account-info/v3/details"
      },
      "response": {
        "status": 200,
        "headers": {},
        "body": {
          "portalId": 4242001,
          "companyCurrency": "USD",
          "timeZone": "US/Eastern",
          "uiDomain": "app.hubspot.com"
        }
      }
    }
  ]
}
